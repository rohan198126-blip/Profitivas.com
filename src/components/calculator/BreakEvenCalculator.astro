---
import CalculatorInput from './CalculatorInput.astro';
import { AlertCircle } from 'lucide-astro';
---

<div id="break-even-app" class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-8 lg:p-10">
  <!-- Presets & Reset Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--border)]">
    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)]">
      Break-Even Point
    </div>

    <!-- Presets & Reset -->
    <div class="flex items-center justify-between sm:justify-end gap-3 text-xs text-[var(--text-muted)]">
      <div class="flex items-center gap-1.5">
        <span class="hidden md:inline text-[11px] text-[var(--text-muted)]">Presets:</span>
        <button
          type="button"
          class="be-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-fixed="10000"
          data-price="50"
          data-var="30"
        >
          $10k / $50 / $30
        </button>
        <button
          type="button"
          class="be-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-fixed="5000"
          data-price="100"
          data-var="40"
        >
          $5k / $100 / $40
        </button>
        <button
          type="button"
          class="be-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-fixed="25000"
          data-price="200"
          data-var="120"
        >
          $25k / $200 / $120
        </button>
      </div>

      <button
        type="button"
        id="be-btn-reset"
        class="text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors py-1 px-2.5 rounded-md hover:bg-[var(--surface-elevated)] cursor-pointer"
        title="Reset inputs to default"
      >
        Reset
      </button>
    </div>
  </div>

  <!-- Workspace Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 pt-8 items-start">
    <!-- Left: Inputs -->
    <div class="lg:col-span-5 space-y-6">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-4">
          Cost & Price Inputs
        </span>

        <div
          id="be-error-box"
          class="hidden text-xs text-[var(--negative-text)] flex items-center gap-1.5 py-1 mb-3"
          role="alert"
        >
          <AlertCircle class="w-3.5 h-3.5 text-[var(--negative)] shrink-0" />
          <span id="be-error-msg">Selling price must be greater than variable cost per unit.</span>
        </div>

        <form id="be-form" class="space-y-5 sm:space-y-6" onsubmit="return false;">
          <CalculatorInput
            id="be-input-fixed"
            name="fixedCosts"
            label="Total Fixed Costs"
            value="10000"
            prefix="$"
            placeholder="0.00"
            helperText="Rent, overhead, payroll, software, insurance."
            required
          />

          <CalculatorInput
            id="be-input-price"
            name="pricePerUnit"
            label="Selling Price per Unit"
            value="50"
            prefix="$"
            placeholder="0.00"
            helperText="Revenue collected from customer for each unit sold."
            required
          />

          <CalculatorInput
            id="be-input-var"
            name="variableCostPerUnit"
            label="Variable Cost per Unit"
            value="30"
            prefix="$"
            placeholder="0.00"
            helperText="Materials, production, packaging, direct fulfillment."
            required
          />
        </form>
      </div>

      <div class="text-xs text-[var(--text-muted)] pt-3 flex items-center justify-between border-t border-[var(--border)]">
        <span>Instant calculation</span>
        <span>Per-period baseline</span>
      </div>
    </div>

    <!-- Right: Dominant Result -->
    <div class="lg:col-span-7 lg:border-l lg:border-[var(--border)] lg:pl-10 space-y-7" aria-live="polite">
      <div id="be-empty-state" class="hidden py-12 text-center sm:text-left space-y-2">
        <p class="text-sm font-medium text-[var(--text-primary)]">Enter fixed costs, price, and variable cost to calculate break-even.</p>
        <p class="text-xs text-[var(--text-muted)]">Find the exact sales volume needed to avoid operating losses.</p>
      </div>

      <div id="be-active-container" class="space-y-7">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-3">
            Break-Even Target
          </span>

          <div class="py-1">
            <span class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-2">
              Break-Even Sales Volume
            </span>
            <div class="flex items-baseline gap-2">
              <span
                id="be-result-primary"
                class="text-6xl sm:text-7xl lg:text-8xl font-semibold tracking-tight text-[var(--text-primary)] tabular-nums leading-none"
              >
                500
              </span>
              <span class="text-xl sm:text-2xl font-medium text-[var(--text-secondary)]">units</span>
            </div>
            <p id="be-result-summary" class="text-xs sm:text-sm text-[var(--text-secondary)] mt-3 leading-relaxed max-w-md">
              Selling <strong class="text-[var(--text-primary)] font-semibold">500 units</strong> yields <strong class="text-[var(--text-primary)] font-semibold">$25,000.00</strong> in revenue to cover $10,000.00 in fixed overhead.
            </p>
          </div>
        </div>

        <!-- Secondary Metrics -->
        <div class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">Break-even revenue</span>
            <span id="be-res-revenue" class="font-semibold text-[var(--text-primary)] tabular-nums">
              $25,000.00
            </span>
          </div>

          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">Contribution margin per unit</span>
            <span id="be-res-cm" class="font-medium text-[var(--positive-text)] tabular-nums">
              $20.00
            </span>
          </div>

          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">Contribution margin ratio</span>
            <span id="be-res-cm-ratio" class="font-medium text-[var(--text-primary)] tabular-nums">
              40.00%
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateBreakEven } from '../../lib/calculators/break-even/formulas';
  import { formatCurrency, formatPercent, formatNumber } from '../../lib/utils/formatters';
  import { parseCleanNumber } from '../../lib/utils/math';

  function setupBreakEvenCalculator() {
    const fixedInput = document.getElementById('be-input-fixed') as HTMLInputElement | null;
    const priceInput = document.getElementById('be-input-price') as HTMLInputElement | null;
    const varInput = document.getElementById('be-input-var') as HTMLInputElement | null;

    const primaryEl = document.getElementById('be-result-primary');
    const revenueEl = document.getElementById('be-res-revenue');
    const cmEl = document.getElementById('be-res-cm');
    const cmRatioEl = document.getElementById('be-res-cm-ratio');
    const summaryEl = document.getElementById('be-result-summary');

    const errorBox = document.getElementById('be-error-box');
    const errorMsg = document.getElementById('be-error-msg');
    const emptyState = document.getElementById('be-empty-state');
    const activeContainer = document.getElementById('be-active-container');
    const resetBtn = document.getElementById('be-btn-reset');

    if (!fixedInput || !priceInput || !varInput) return;

    function recalculate() {
      const fixedVal = parseCleanNumber(fixedInput?.value);
      const priceVal = parseCleanNumber(priceInput?.value);
      const varVal = parseCleanNumber(varInput?.value);

      if (fixedVal === null || priceVal === null || varVal === null) {
        activeContainer?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        errorBox?.classList.add('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      activeContainer?.classList.remove('hidden');

      const result = calculateBreakEven({
        fixedCosts: fixedVal,
        pricePerUnit: priceVal,
        variableCostPerUnit: varVal,
      });

      if (!result.isValid) {
        errorBox?.classList.remove('hidden');
        if (errorMsg) errorMsg.textContent = result.errorMessage || 'Invalid inputs.';
        return;
      }

      errorBox?.classList.add('hidden');

      if (primaryEl) primaryEl.textContent = formatNumber(result.breakEvenUnits, result.breakEvenUnits % 1 === 0 ? 0 : 2);
      if (revenueEl) revenueEl.textContent = formatCurrency(result.breakEvenRevenue);
      if (cmEl) cmEl.textContent = formatCurrency(result.contributionMargin);
      if (cmRatioEl) cmRatioEl.textContent = formatPercent(result.contributionMarginRatio);

      if (summaryEl) {
        summaryEl.innerHTML = `Selling <strong class="text-[var(--text-primary)] font-semibold">${formatNumber(result.breakEvenUnits, result.breakEvenUnits % 1 === 0 ? 0 : 2)} units</strong> yields <strong class="text-[var(--text-primary)] font-semibold">${formatCurrency(result.breakEvenRevenue)}</strong> in revenue to cover ${formatCurrency(result.fixedCosts)} in fixed overhead.`;
      }
    }

    fixedInput.addEventListener('input', recalculate);
    priceInput.addEventListener('input', recalculate);
    varInput.addEventListener('input', recalculate);

    document.querySelectorAll<HTMLButtonElement>('.be-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (fixedInput) fixedInput.value = btn.dataset.fixed || '10000';
        if (priceInput) priceInput.value = btn.dataset.price || '50';
        if (varInput) varInput.value = btn.dataset.var || '30';
        recalculate();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (fixedInput) fixedInput.value = '10000';
      if (priceInput) priceInput.value = '50';
      if (varInput) varInput.value = '30';
      recalculate();
    });

    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBreakEvenCalculator);
  } else {
    setupBreakEvenCalculator();
  }
  document.addEventListener('astro:page-load', setupBreakEvenCalculator);
</script>
