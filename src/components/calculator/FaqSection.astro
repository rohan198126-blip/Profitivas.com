---
import type { FAQItem } from '../../lib/calculators/types';
import type { SupportedLocale } from '../../lib/i18n/types';
import { useTranslations } from '../../lib/i18n';
import JsonLd from '../seo/JsonLd.astro';
import { getFaqSchema } from '../../lib/seo/schema';

export interface Props {
  faqs: FAQItem[];
  locale?: SupportedLocale;
}

const { faqs, locale = 'en' } = Astro.props;
const t = useTranslations(locale);
---

<section aria-labelledby="faqs-heading" class="space-y-4">
  <div>
    <h2 id="faqs-heading" class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-1">
      {t.calculatorSections.frequentlyAskedQuestions}
    </h2>
    <p class="text-xs sm:text-sm text-[var(--text-secondary)]">
      {t.calculatorSections.methodologyDescription}
    </p>
  </div>

  <div class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
    {faqs.map((faq) => (
      <div class="py-4 sm:py-5 space-y-1.5">
        <h3 class="font-medium text-[var(--text-primary)] text-sm sm:text-base">
          {faq.question}
        </h3>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed font-normal">
          {faq.answer}
        </p>
      </div>
    ))}
  </div>
</section>

<JsonLd schema={getFaqSchema(faqs)} />
