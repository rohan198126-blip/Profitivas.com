---
import CalculatorInput from './CalculatorInput.astro';
import { AlertCircle } from 'lucide-astro';
import type { SupportedLocale } from '../../lib/i18n/types';
import { useTranslations } from '../../lib/i18n';
import { getWidgetTranslation, getCalcCurrency, formatCalcMoney } from '../../lib/i18n/calculators/widgets';

export interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const wt = getWidgetTranslation('gross-profit', locale);
const curr = getCalcCurrency(locale);
---

<div
  id="gross-profit-app"
  class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-8 lg:p-10"
  data-locale={locale}
  data-curr-code={curr.code}
  data-curr-decimals={curr.decimals}
>
  <!-- Presets & Reset Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--border)]">
    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)]">
      {wt.title || 'Gross Profit & Margin'}
    </div>

    <!-- Presets & Reset -->
    <div class="flex items-center justify-between sm:justify-end gap-3 text-xs text-[var(--text-muted)]">
      <div class="flex items-center gap-1.5">
        <span class="hidden md:inline text-[11px] text-[var(--text-muted)]">{t.common.presets}:</span>
        <button
          type="button"
          class="gp-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-rev="100000"
          data-cogs="40000"
        >
          {wt.presets[0]}
        </button>
        <button
          type="button"
          class="gp-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-rev="50000"
          data-cogs="15000"
        >
          {wt.presets[1]}
        </button>
        <button
          type="button"
          class="gp-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-rev="250000"
          data-cogs="175000"
        >
          {wt.presets[2]}
        </button>
      </div>

      <button
        type="button"
        id="gp-btn-reset"
        class="text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors py-1 px-2.5 rounded-md hover:bg-[var(--surface-elevated)] cursor-pointer"
        title="Reset inputs to default"
      >
        {t.actions.reset}
      </button>
    </div>
  </div>

  <!-- Workspace Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 pt-8 items-start">
    <!-- Left: Inputs -->
    <div class="lg:col-span-5 space-y-6">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-4">
          {t.common.yourNumbers}
        </span>

        <div
          id="gp-error-box"
          class="hidden text-xs text-[var(--negative-text)] flex items-center gap-1.5 py-1 mb-3"
          role="alert"
        >
          <AlertCircle class="w-3.5 h-3.5 text-[var(--negative)] shrink-0" />
          <span id="gp-error-msg">{wt.errors.general || 'Please enter valid non-negative numbers.'}</span>
        </div>

        <form id="gp-form" class="space-y-5 sm:space-y-6" onsubmit="return false;">
          <CalculatorInput
            id="gp-input-revenue"
            name="revenue"
            label={wt.labels.revenue}
            value="100000"
            prefix={curr.symbol}
            placeholder={curr.decimals === 0 ? '0' : '0.00'}
            helperText={wt.helpers.revenue}
            required
          />

          <CalculatorInput
            id="gp-input-cogs"
            name="cogs"
            label={wt.labels.cogs}
            value="40000"
            prefix={curr.symbol}
            placeholder={curr.decimals === 0 ? '0' : '0.00'}
            helperText={wt.helpers.cogs}
            required
          />
        </form>
      </div>

      <div class="text-xs text-[var(--text-muted)] pt-3 flex items-center justify-between border-t border-[var(--border)]">
        <span>{t.common.automaticRecalculation}</span>
        <span>{t.common.preTax}</span>
      </div>
    </div>

    <!-- Right: Dominant Result -->
    <div class="lg:col-span-7 lg:border-l lg:border-[var(--border)] lg:pl-10 space-y-7" aria-live="polite">
      <div id="gp-empty-state" class="hidden py-12 text-center sm:text-left space-y-2">
        <p class="text-sm font-medium text-[var(--text-primary)]">{wt.emptyState.title}</p>
        <p class="text-xs text-[var(--text-muted)]">{wt.emptyState.desc}</p>
      </div>

      <div id="gp-active-container" class="space-y-7">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-3">
            {t.common.yourResult}
          </span>

          <div class="py-1">
            <span class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-2">
              {wt.results.grossProfit}
            </span>
            <div
              id="gp-result-primary"
              class="text-6xl sm:text-7xl lg:text-8xl font-semibold tracking-tight text-[var(--positive-text)] tabular-nums leading-none"
            >
              {formatCalcMoney(60000, locale)}
            </div>
            <p id="gp-result-summary" class="text-xs sm:text-sm text-[var(--text-secondary)] mt-3 leading-relaxed max-w-md">
              Your business retains <strong class="text-[var(--text-primary)] font-semibold">{formatCalcMoney(60000, locale)}</strong> on {formatCalcMoney(100000, locale)} of total revenue.
            </p>
          </div>
        </div>

        <!-- Secondary Metrics -->
        <div class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">{wt.results.grossMargin}</span>
            <span id="gp-res-margin" class="font-semibold text-[var(--text-primary)] tabular-nums">
              60.00%
            </span>
          </div>

          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">{wt.labels.cogs}</span>
            <span id="gp-res-cogs" class="font-medium text-[var(--text-primary)] tabular-nums">
              {formatCalcMoney(40000, locale)}
            </span>
          </div>

          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">{wt.results.markup}</span>
            <span id="gp-res-markup" class="font-medium text-[var(--text-primary)] tabular-nums">
              150.00%
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateGrossProfit } from '../../lib/calculators/gross-profit/formulas';
  import { formatCurrency, formatPercent } from '../../lib/utils/formatters';
  import { parseCleanNumber } from '../../lib/utils/math';

  function setupGrossProfitCalculator() {
    const root = document.getElementById('gross-profit-app');
    if (!root) return;

    const locale = (root.getAttribute('data-locale') as any) || 'en';
    const currCode = root.getAttribute('data-curr-code') || 'USD';
    const currDecimals = parseInt(root.getAttribute('data-curr-decimals') || '2', 10);

    function formatMoney(val: number | null | undefined): string {
      return formatCurrency(val, currCode, currDecimals, currDecimals, locale);
    }

    const revenueInput = document.getElementById('gp-input-revenue') as HTMLInputElement | null;
    const cogsInput = document.getElementById('gp-input-cogs') as HTMLInputElement | null;

    const primaryEl = document.getElementById('gp-result-primary');
    const marginEl = document.getElementById('gp-res-margin');
    const cogsEl = document.getElementById('gp-res-cogs');
    const markupEl = document.getElementById('gp-res-markup');
    const summaryEl = document.getElementById('gp-result-summary');

    const errorBox = document.getElementById('gp-error-box');
    const errorMsg = document.getElementById('gp-error-msg');
    const emptyState = document.getElementById('gp-empty-state');
    const activeContainer = document.getElementById('gp-active-container');
    const resetBtn = document.getElementById('gp-btn-reset');

    if (!revenueInput || !cogsInput) return;

    function recalculate() {
      const revenueVal = parseCleanNumber(revenueInput?.value);
      const cogsVal = parseCleanNumber(cogsInput?.value);

      if (revenueVal === null || cogsVal === null) {
        activeContainer?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        errorBox?.classList.add('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      activeContainer?.classList.remove('hidden');

      const result = calculateGrossProfit({ revenue: revenueVal, cogs: cogsVal });

      if (!result.isValid) {
        errorBox?.classList.remove('hidden');
        if (errorMsg) errorMsg.textContent = result.errorMessage || 'Invalid inputs.';
        return;
      }

      errorBox?.classList.add('hidden');

      if (primaryEl) {
        primaryEl.textContent = formatMoney(result.grossProfit);
        if (result.grossProfit < 0) {
          primaryEl.classList.remove('text-[var(--positive-text)]');
          primaryEl.classList.add('text-[var(--negative-text)]');
        } else {
          primaryEl.classList.remove('text-[var(--negative-text)]');
          primaryEl.classList.add('text-[var(--positive-text)]');
        }
      }

      if (marginEl) marginEl.textContent = formatPercent(result.grossMargin, 2, locale);
      if (cogsEl) cogsEl.textContent = formatMoney(result.cogs);
      if (markupEl) markupEl.textContent = formatPercent(result.markup, 2, locale);

      if (summaryEl) {
        summaryEl.innerHTML = `Your business retains <strong class="text-[var(--text-primary)] font-semibold">${formatMoney(result.grossProfit)}</strong> on ${formatMoney(result.revenue)} of total revenue.`;
      }
    }

    revenueInput.addEventListener('input', recalculate);
    cogsInput.addEventListener('input', recalculate);

    document.querySelectorAll<HTMLButtonElement>('.gp-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (revenueInput) revenueInput.value = btn.dataset.rev || '100000';
        if (cogsInput) cogsInput.value = btn.dataset.cogs || '40000';
        recalculate();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (revenueInput) revenueInput.value = '100000';
      if (cogsInput) cogsInput.value = '40000';
      recalculate();
    });

    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGrossProfitCalculator);
  } else {
    setupGrossProfitCalculator();
  }
  document.addEventListener('astro:page-load', setupGrossProfitCalculator);
</script>
