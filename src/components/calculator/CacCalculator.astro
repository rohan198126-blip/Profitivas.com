---
import CalculatorInput from './CalculatorInput.astro';
import { AlertCircle } from 'lucide-astro';
---

<div id="cac-app" class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-8 lg:p-10">
  <!-- Presets & Reset Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--border)]">
    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)]">
      Customer Acquisition Cost
    </div>

    <!-- Presets & Reset -->
    <div class="flex items-center justify-between sm:justify-end gap-3 text-xs text-[var(--text-muted)]">
      <div class="flex items-center gap-1.5">
        <span class="hidden md:inline text-[11px] text-[var(--text-muted)]">Presets:</span>
        <button
          type="button"
          class="cac-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-cost="8000"
          data-cust="160"
        >
          $8k / 160 ($50)
        </button>
        <button
          type="button"
          class="cac-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-cost="15000"
          data-cust="100"
        >
          $15k / 100 ($150)
        </button>
        <button
          type="button"
          class="cac-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-cost="3000"
          data-cust="30"
        >
          $3k / 30 ($100)
        </button>
      </div>

      <button
        type="button"
        id="cac-btn-reset"
        class="text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors py-1 px-2.5 rounded-md hover:bg-[var(--surface-elevated)] cursor-pointer"
        title="Reset inputs to default"
      >
        Reset
      </button>
    </div>
  </div>

  <!-- Workspace Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 pt-8 items-start">
    <!-- Left: Inputs -->
    <div class="lg:col-span-5 space-y-6">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-4">
          Acquisition Investment
        </span>

        <div
          id="cac-error-box"
          class="hidden text-xs text-[var(--negative-text)] flex items-center gap-1.5 py-1 mb-3"
          role="alert"
        >
          <AlertCircle class="w-3.5 h-3.5 text-[var(--negative)] shrink-0" />
          <span id="cac-error-msg">New customers acquired must be greater than 0.</span>
        </div>

        <form id="cac-form" class="space-y-5 sm:space-y-6" onsubmit="return false;">
          <CalculatorInput
            id="cac-input-cost"
            name="acquisitionCosts"
            label="Total Sales & Marketing Spend"
            value="8000"
            prefix="$"
            placeholder="0.00"
            helperText="Ad spend, salaries, software tools, agency fees."
            required
          />

          <CalculatorInput
            id="cac-input-cust"
            name="newCustomers"
            label="New Customers Acquired"
            value="160"
            placeholder="0"
            helperText="Count of newly onboarded paying customers."
            required
          />
        </form>
      </div>

      <div class="text-xs text-[var(--text-muted)] pt-3 flex items-center justify-between border-t border-[var(--border)]">
        <span>Instant calculation</span>
        <span>Per-customer unit cost</span>
      </div>
    </div>

    <!-- Right: Dominant Result -->
    <div class="lg:col-span-7 lg:border-l lg:border-[var(--border)] lg:pl-10 space-y-7" aria-live="polite">
      <div id="cac-empty-state" class="hidden py-12 text-center sm:text-left space-y-2">
        <p class="text-sm font-medium text-[var(--text-primary)]">Enter total marketing costs and new customer count.</p>
        <p class="text-xs text-[var(--text-muted)]">Determine exact unit cost per paying customer acquired.</p>
      </div>

      <div id="cac-active-container" class="space-y-7">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-3">
            Unit Acquisition Cost
          </span>

          <div class="py-1">
            <span class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-2">
              Customer Acquisition Cost
            </span>
            <div
              id="cac-result-primary"
              class="text-6xl sm:text-7xl lg:text-8xl font-semibold tracking-tight text-[var(--text-primary)] tabular-nums leading-none"
            >
              $50.00
            </div>
            <p id="cac-result-summary" class="text-xs sm:text-sm text-[var(--text-secondary)] mt-3 leading-relaxed max-w-md">
              Acquiring 160 customers for $8,000.00 requires an average acquisition investment of <strong class="text-[var(--text-primary)] font-semibold">$50.00</strong> per customer.
            </p>
          </div>
        </div>

        <!-- Secondary Metrics -->
        <div class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">Total acquisition spend</span>
            <span id="cac-res-spend" class="font-medium text-[var(--text-primary)] tabular-nums">
              $8,000.00
            </span>
          </div>

          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">New customers acquired</span>
            <span id="cac-res-cust" class="font-medium text-[var(--text-primary)] tabular-nums">
              160
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateCac } from '../../lib/calculators/cac/formulas';
  import { formatCurrency, formatNumber } from '../../lib/utils/formatters';
  import { parseCleanNumber } from '../../lib/utils/math';

  function setupCacCalculator() {
    const costInput = document.getElementById('cac-input-cost') as HTMLInputElement | null;
    const custInput = document.getElementById('cac-input-cust') as HTMLInputElement | null;

    const primaryEl = document.getElementById('cac-result-primary');
    const spendEl = document.getElementById('cac-res-spend');
    const custEl = document.getElementById('cac-res-cust');
    const summaryEl = document.getElementById('cac-result-summary');

    const errorBox = document.getElementById('cac-error-box');
    const errorMsg = document.getElementById('cac-error-msg');
    const emptyState = document.getElementById('cac-empty-state');
    const activeContainer = document.getElementById('cac-active-container');
    const resetBtn = document.getElementById('cac-btn-reset');

    if (!costInput || !custInput) return;

    function recalculate() {
      const costVal = parseCleanNumber(costInput?.value);
      const custVal = parseCleanNumber(custInput?.value);

      if (costVal === null || custVal === null) {
        activeContainer?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        errorBox?.classList.add('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      activeContainer?.classList.remove('hidden');

      const result = calculateCac({ acquisitionCosts: costVal, newCustomers: custVal });

      if (!result.isValid) {
        errorBox?.classList.remove('hidden');
        if (errorMsg) errorMsg.textContent = result.errorMessage || 'Invalid inputs.';
        return;
      }

      errorBox?.classList.add('hidden');

      if (primaryEl) primaryEl.textContent = formatCurrency(result.cac);
      if (spendEl) spendEl.textContent = formatCurrency(result.acquisitionCosts);
      if (custEl) custEl.textContent = formatNumber(result.newCustomers, result.newCustomers % 1 === 0 ? 0 : 2);

      if (summaryEl) {
        summaryEl.innerHTML = `Acquiring ${formatNumber(result.newCustomers, result.newCustomers % 1 === 0 ? 0 : 2)} customers for ${formatCurrency(result.acquisitionCosts)} requires an average acquisition investment of <strong class="text-[var(--text-primary)] font-semibold">${formatCurrency(result.cac)}</strong> per customer.`;
      }
    }

    costInput.addEventListener('input', recalculate);
    custInput.addEventListener('input', recalculate);

    document.querySelectorAll<HTMLButtonElement>('.cac-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (costInput) costInput.value = btn.dataset.cost || '8000';
        if (custInput) custInput.value = btn.dataset.cust || '160';
        recalculate();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (costInput) costInput.value = '8000';
      if (custInput) custInput.value = '160';
      recalculate();
    });

    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCacCalculator);
  } else {
    setupCacCalculator();
  }
  document.addEventListener('astro:page-load', setupCacCalculator);
</script>
