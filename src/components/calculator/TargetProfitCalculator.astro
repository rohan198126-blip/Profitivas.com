---
import CalculatorInput from './CalculatorInput.astro';
import { AlertCircle } from 'lucide-astro';
import type { SupportedLocale } from '../../lib/i18n/types';
import { useTranslations } from '../../lib/i18n';
import { getWidgetTranslation, getCalcCurrency, formatCalcMoney } from '../../lib/i18n/calculators/widgets';

export interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const wt = getWidgetTranslation('target-profit', locale);
const curr = getCalcCurrency(locale);
---

<div
  id="target-profit-app"
  class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-8 lg:p-10"
  data-locale={locale}
  data-curr-code={curr.code}
  data-curr-decimals={curr.decimals}
>
  <!-- Presets & Reset Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--border)]">
    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)]">
      {wt.title || 'Target Profit Planning'}
    </div>

    <!-- Presets & Reset -->
    <div class="flex items-center justify-between sm:justify-end gap-3 text-xs text-[var(--text-muted)]">
      <div class="flex items-center gap-1.5">
        <span class="hidden md:inline text-[11px] text-[var(--text-muted)]">{t.common.presets}:</span>
        <button
          type="button"
          class="tp-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-fixed="10000"
          data-target="5000"
          data-price="50"
          data-var="30"
        >
          {wt.presets[0]}
        </button>
        <button
          type="button"
          class="tp-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-fixed="20000"
          data-target="10000"
          data-price="100"
          data-var="40"
        >
          {wt.presets[1]}
        </button>
        <button
          type="button"
          class="tp-preset-btn px-2.5 py-1 text-xs font-normal rounded-md hover:bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors border border-[var(--border)] tabular-nums cursor-pointer"
          data-fixed="50000"
          data-target="25000"
          data-price="250"
          data-var="150"
        >
          {wt.presets[2]}
        </button>
      </div>

      <button
        type="button"
        id="tp-btn-reset"
        class="text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors py-1 px-2.5 rounded-md hover:bg-[var(--surface-elevated)] cursor-pointer"
        title="Reset inputs to default"
      >
        {t.actions.reset}
      </button>
    </div>
  </div>

  <!-- Workspace Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 pt-8 items-start">
    <!-- Left: Inputs -->
    <div class="lg:col-span-5 space-y-6">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-4">
          {t.common.yourNumbers}
        </span>

        <div
          id="tp-error-box"
          class="hidden text-xs text-[var(--negative-text)] flex items-center gap-1.5 py-1 mb-3"
          role="alert"
        >
          <AlertCircle class="w-3.5 h-3.5 text-[var(--negative)] shrink-0" />
          <span id="tp-error-msg">{wt.errors.priceGreater || 'Selling price must be greater than variable cost per unit.'}</span>
        </div>

        <form id="tp-form" class="space-y-4 sm:space-y-5" onsubmit="return false;">
          <CalculatorInput
            id="tp-input-fixed"
            name="fixedCosts"
            label={wt.labels.fixedCosts}
            value="10000"
            prefix={curr.symbol}
            placeholder={curr.decimals === 0 ? '0' : '0.00'}
            helperText={wt.helpers.fixedCosts}
            required
          />

          <CalculatorInput
            id="tp-input-target"
            name="targetProfit"
            label={wt.labels.targetProfit}
            value="5000"
            prefix={curr.symbol}
            placeholder={curr.decimals === 0 ? '0' : '0.00'}
            helperText={wt.helpers.targetProfit}
            required
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <CalculatorInput
              id="tp-input-price"
              name="pricePerUnit"
              label={wt.labels.pricePerUnit}
              value="50"
              prefix={curr.symbol}
              placeholder={curr.decimals === 0 ? '0' : '0.00'}
              helperText={wt.helpers.pricePerUnit}
              required
            />

            <CalculatorInput
              id="tp-input-var"
              name="variableCostPerUnit"
              label={wt.labels.variableCostPerUnit}
              value="30"
              prefix={curr.symbol}
              placeholder={curr.decimals === 0 ? '0' : '0.00'}
              helperText={wt.helpers.variableCostPerUnit}
              required
            />
          </div>
        </form>
      </div>

      <div class="text-xs text-[var(--text-muted)] pt-3 flex items-center justify-between border-t border-[var(--border)]">
        <span>{t.common.automaticRecalculation}</span>
        <span>{t.common.preTax}</span>
      </div>
    </div>

    <!-- Right: Dominant Result -->
    <div class="lg:col-span-7 lg:border-l lg:border-[var(--border)] lg:pl-10 space-y-7" aria-live="polite">
      <div id="tp-empty-state" class="hidden py-12 text-center sm:text-left space-y-2">
        <p class="text-sm font-medium text-[var(--text-primary)]">{wt.emptyState.title}</p>
        <p class="text-xs text-[var(--text-muted)]">{wt.emptyState.desc}</p>
      </div>

      <div id="tp-active-container" class="space-y-7">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-3">
            {t.common.yourResult}
          </span>

          <div class="py-1">
            <span class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--text-muted)] block mb-2">
              {wt.results.primaryUnits || 'Units Needed'}
            </span>
            <div class="flex items-baseline gap-2">
              <span
                id="tp-result-primary"
                class="text-6xl sm:text-7xl lg:text-8xl font-semibold tracking-tight text-[var(--text-primary)] tabular-nums leading-none"
              >
                750
              </span>
              <span class="text-xl sm:text-2xl font-medium text-[var(--text-secondary)]">units</span>
            </div>
            <p id="tp-result-summary" class="text-xs sm:text-sm text-[var(--text-secondary)] mt-3 leading-relaxed max-w-md">
              Selling <strong class="text-[var(--text-primary)] font-semibold">750 units</strong> generates <strong class="text-[var(--text-primary)] font-semibold">{formatCalcMoney(37500, locale)}</strong> revenue to deliver {formatCalcMoney(5000, locale)} profit.
            </p>
          </div>
        </div>

        <!-- Secondary Metrics -->
        <div class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">{wt.results.primaryRevenue || 'Required sales revenue'}</span>
            <span id="tp-res-revenue" class="font-semibold text-[var(--text-primary)] tabular-nums">
              {formatCalcMoney(37500, locale)}
            </span>
          </div>

          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">{wt.results.unitMargin || 'Contribution margin per unit'}</span>
            <span id="tp-res-cm" class="font-medium text-[var(--positive-text)] tabular-nums">
              {formatCalcMoney(20, locale)}
            </span>
          </div>

          <div class="py-3 flex items-center justify-between text-xs sm:text-sm">
            <span class="text-[var(--text-secondary)] font-normal">{wt.results.totalBurden || 'Total cost burden (fixed + target)'}</span>
            <span id="tp-res-burden" class="font-medium text-[var(--text-primary)] tabular-nums">
              {formatCalcMoney(15000, locale)}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateTargetProfit } from '../../lib/calculators/target-profit/formulas';
  import { formatCurrency, formatNumber } from '../../lib/utils/formatters';
  import { parseCleanNumber } from '../../lib/utils/math';

  function setupTargetProfitCalculator() {
    const root = document.getElementById('target-profit-app');
    if (!root) return;

    const locale = (root.getAttribute('data-locale') as any) || 'en';
    const currCode = root.getAttribute('data-curr-code') || 'USD';
    const currDecimals = parseInt(root.getAttribute('data-curr-decimals') || '2', 10);

    function formatMoney(val: number | null | undefined): string {
      return formatCurrency(val, currCode, currDecimals, currDecimals, locale);
    }

    const fixedInput = document.getElementById('tp-input-fixed') as HTMLInputElement | null;
    const targetInput = document.getElementById('tp-input-target') as HTMLInputElement | null;
    const priceInput = document.getElementById('tp-input-price') as HTMLInputElement | null;
    const varInput = document.getElementById('tp-input-var') as HTMLInputElement | null;

    const primaryEl = document.getElementById('tp-result-primary');
    const revenueEl = document.getElementById('tp-res-revenue');
    const cmEl = document.getElementById('tp-res-cm');
    const burdenEl = document.getElementById('tp-res-burden');
    const summaryEl = document.getElementById('tp-result-summary');

    const errorBox = document.getElementById('tp-error-box');
    const errorMsg = document.getElementById('tp-error-msg');
    const emptyState = document.getElementById('tp-empty-state');
    const activeContainer = document.getElementById('tp-active-container');
    const resetBtn = document.getElementById('tp-btn-reset');

    if (!fixedInput || !targetInput || !priceInput || !varInput) return;

    function recalculate() {
      const fixedVal = parseCleanNumber(fixedInput?.value);
      const targetVal = parseCleanNumber(targetInput?.value);
      const priceVal = parseCleanNumber(priceInput?.value);
      const varVal = parseCleanNumber(varInput?.value);

      if (fixedVal === null || targetVal === null || priceVal === null || varVal === null) {
        activeContainer?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        errorBox?.classList.add('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      activeContainer?.classList.remove('hidden');

      const result = calculateTargetProfit({
        fixedCosts: fixedVal,
        targetProfit: targetVal,
        pricePerUnit: priceVal,
        variableCostPerUnit: varVal,
      });

      if (!result.isValid) {
        errorBox?.classList.remove('hidden');
        if (errorMsg) errorMsg.textContent = result.errorMessage || 'Invalid inputs.';
        return;
      }

      errorBox?.classList.add('hidden');

      const totalBurden = result.fixedCosts + result.targetProfit;

      if (primaryEl) primaryEl.textContent = formatNumber(result.requiredUnits, result.requiredUnits % 1 === 0 ? 0 : 2, locale);
      if (revenueEl) revenueEl.textContent = formatMoney(result.requiredRevenue);
      if (cmEl) cmEl.textContent = formatMoney(result.contributionMargin);
      if (burdenEl) burdenEl.textContent = formatMoney(totalBurden);

      if (summaryEl) {
        summaryEl.innerHTML = `Selling <strong class="text-[var(--text-primary)] font-semibold">${formatNumber(result.requiredUnits, result.requiredUnits % 1 === 0 ? 0 : 2, locale)} units</strong> generates <strong class="text-[var(--text-primary)] font-semibold">${formatMoney(result.requiredRevenue)}</strong> revenue to deliver ${formatMoney(result.targetProfit)} profit.`;
      }
    }

    fixedInput.addEventListener('input', recalculate);
    targetInput.addEventListener('input', recalculate);
    priceInput.addEventListener('input', recalculate);
    varInput.addEventListener('input', recalculate);

    document.querySelectorAll<HTMLButtonElement>('.tp-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (fixedInput) fixedInput.value = btn.dataset.fixed || '10000';
        if (targetInput) targetInput.value = btn.dataset.target || '5000';
        if (priceInput) priceInput.value = btn.dataset.price || '50';
        if (varInput) varInput.value = btn.dataset.var || '30';
        recalculate();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (fixedInput) fixedInput.value = '10000';
      if (targetInput) targetInput.value = '5000';
      if (priceInput) priceInput.value = '50';
      if (varInput) varInput.value = '30';
      recalculate();
    });

    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTargetProfitCalculator);
  } else {
    setupTargetProfitCalculator();
  }
  document.addEventListener('astro:page-load', setupTargetProfitCalculator);
</script>
