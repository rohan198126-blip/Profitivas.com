---
import { getInvoiceTranslations } from '../../lib/i18n/invoice';
import { getLocalizedPath } from '../../lib/i18n';
import type { SupportedLocale } from '../../lib/i18n/types';

export interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
const t = getInvoiceTranslations(locale);
const f = t.homepageFeatured;
const d = t.document;
const invoicePath = getLocalizedPath('/invoice-generator', locale);
---

<section aria-labelledby="featured-tool-heading" class="pt-16 sm:pt-20 border-t border-[var(--border)] mb-24 sm:mb-32">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
    <!-- LEFT: Editorial Copy & CTA -->
    <div class="lg:col-span-6 space-y-5">
      <div class="space-y-2">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-[var(--text-muted)]">
          {f.eyebrow}
        </p>
        <h2 id="featured-tool-heading" class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[var(--text-primary)] tracking-tight leading-[1.15]">
          {f.headline}
        </h2>
      </div>

      <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed font-normal max-w-lg">
        {f.description}
      </p>

      <div class="pt-2 flex flex-col sm:flex-row sm:items-center gap-4">
        <a
          href={invoicePath}
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-semibold rounded-lg bg-[var(--text-primary)] text-[var(--background)] hover:opacity-90 transition-opacity cursor-pointer self-start focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
        >
          <span>{f.cta}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <p class="text-xs text-[var(--text-muted)] tracking-normal">
          {f.trustLine}
        </p>
      </div>
    </div>

    <!-- RIGHT: Realistic Miniature Invoice Document Preview -->
    <div class="lg:col-span-6 w-full max-w-full">
      <div class="bg-white text-neutral-900 rounded-xl shadow-xl border border-neutral-300/80 p-5 sm:p-7 relative overflow-hidden font-sans text-xs select-none">
        <!-- Discreet Example Badge -->
        <div class="absolute top-4 right-4 text-[9px] uppercase tracking-wider font-mono font-medium text-neutral-500 border border-neutral-300 rounded px-2 py-0.5 bg-neutral-100/90">
          {f.exampleBadge}
        </div>

        <!-- Document Top: Seller Info & Document Type -->
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-5 border-b border-neutral-200">
          <div class="space-y-0.5">
            <h3 class="font-bold text-sm sm:text-base tracking-tight text-neutral-900">
              {f.exampleBusinessName}
            </h3>
            <p class="text-[11px] text-neutral-500">
              100 Market St, Suite 400 &bull; San Francisco, CA
            </p>
          </div>
          <div class="sm:text-right pt-1 sm:pt-0">
            <span class="block font-bold text-sm tracking-wider text-neutral-900 uppercase font-mono">
              {d.invoiceTitle}
            </span>
            <span class="text-[11px] text-neutral-500 font-mono">
              INV-001 &bull; 30d Net
            </span>
          </div>
        </div>

        <!-- Document Metadata: Client & Date Details -->
        <div class="grid grid-cols-2 gap-4 py-4 border-b border-neutral-100 text-[11px]">
          <div>
            <span class="block text-[10px] uppercase tracking-wider font-semibold text-neutral-400 mb-0.5">
              {d.billToLabel}
            </span>
            <p class="font-semibold text-neutral-900">{f.exampleCustomerName}</p>
            <p class="text-neutral-500">client@example.com</p>
          </div>
          <div class="text-right">
            <span class="block text-[10px] uppercase tracking-wider font-semibold text-neutral-400 mb-0.5">
              {d.dateLabel}
            </span>
            <p class="font-mono text-neutral-800">2026-09-14</p>
            <p class="font-mono text-neutral-500">{d.dueDateLabel}: 2026-10-14</p>
          </div>
        </div>

        <!-- Document Miniature Table -->
        <div class="pt-4 overflow-x-auto">
          <table class="w-full text-left text-[11px] border-collapse min-w-[280px]">
            <thead>
              <tr class="border-b border-neutral-200 text-[10px] uppercase tracking-wider font-semibold text-neutral-400">
                <th class="pb-2 font-semibold">{d.descHeader}</th>
                <th class="pb-2 text-right font-semibold w-12">{d.qtyHeader}</th>
                <th class="pb-2 text-right font-semibold w-20">{d.amountHeader}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100 text-neutral-700">
              <tr>
                <td class="py-2.5 pr-2 font-medium text-neutral-900 truncate max-w-[140px] sm:max-w-none">
                  {f.exampleItem1}
                </td>
                <td class="py-2.5 text-right font-mono tabular-nums">1</td>
                <td class="py-2.5 text-right font-mono tabular-nums font-medium text-neutral-900">$1,200.00</td>
              </tr>
              <tr>
                <td class="py-2.5 pr-2 font-medium text-neutral-900 truncate max-w-[140px] sm:max-w-none">
                  {f.exampleItem2}
                </td>
                <td class="py-2.5 text-right font-mono tabular-nums">10</td>
                <td class="py-2.5 text-right font-mono tabular-nums font-medium text-neutral-900">$950.00</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Document Totals Summary -->
        <div class="pt-4 mt-2 border-t border-neutral-200 flex justify-end">
          <div class="w-48 space-y-1.5 text-[11px]">
            <div class="flex justify-between text-neutral-500">
              <span>{d.subtotalLabel}</span>
              <span class="font-mono font-medium text-neutral-800">$2,150.00</span>
            </div>
            <div class="flex justify-between text-neutral-500">
              <span>{d.taxTotalLabel} (8%)</span>
              <span class="font-mono font-medium text-neutral-800">$172.00</span>
            </div>
            <div class="flex justify-between pt-1.5 border-t-2 border-neutral-900 font-bold text-xs sm:text-sm text-neutral-900">
              <span>{d.totalLabel}</span>
              <span class="font-mono">$2,322.00</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
