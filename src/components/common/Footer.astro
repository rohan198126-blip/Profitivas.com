---
import { CATEGORIES, getActiveCalculatorsMeta } from '../../lib/calculators/registry';

const currentYear = new Date().getFullYear();
const activeCalculators = getActiveCalculatorsMeta();
---

<footer class="border-t border-[var(--footer-border)] bg-[var(--footer-bg)] mt-16 sm:mt-24 no-print transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-2">
        <a href="/" class="text-[var(--text-primary)] font-bold text-sm tracking-tight hover:opacity-85 transition-opacity">
          Profitivas
        </a>
        <p class="text-xs text-[var(--text-secondary)] max-w-sm leading-relaxed">
          Business numbers. Better decisions. Fast, modern, mathematically verified calculation tools for operators and founders.
        </p>
      </div>

      <!-- Active Tools -->
      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-2.5">
          Available Tools
        </h3>
        <ul class="space-y-1.5 text-xs text-[var(--text-secondary)]">
          {activeCalculators.map((calc) => (
            <li>
              <a href={`/${calc.slug}`} class="hover:text-[var(--text-primary)] transition-colors">
                {calc.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/calculators" class="text-[var(--text-primary)] underline underline-offset-4 hover:opacity-80 font-medium transition-opacity">
              Browse all calculators &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-2.5">
          Categories
        </h3>
        <ul class="space-y-1.5 text-xs text-[var(--text-secondary)]">
          {CATEGORIES.map((category) => (
            <li>
              <a href={`/calculators#${category.id}`} class="hover:text-[var(--text-primary)] transition-colors">
                {category.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Financial Disclaimer, Legal Links & Copyright -->
    <div class="border-t border-[var(--border-subtle)] pt-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-[11px] text-[var(--text-muted)]">
      <p class="max-w-xl leading-relaxed">
        <strong class="text-[var(--text-secondary)]">Disclaimer:</strong> Profitivas calculators and educational guides are provided for informational and planning purposes only. Calculations should be verified before making major financial commitments.
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 shrink-0">
        <div class="flex items-center gap-4 text-[var(--text-secondary)]">
          <a href="/about" class="hover:text-[var(--text-primary)] transition-colors">About</a>
          <a href="/about#contact" class="hover:text-[var(--text-primary)] transition-colors">Contact</a>
          <a href="/privacy" class="hover:text-[var(--text-primary)] transition-colors">Privacy</a>
          <a href="/terms" class="hover:text-[var(--text-primary)] transition-colors">Terms</a>
        </div>
        <p class="whitespace-nowrap">
          &copy; {currentYear} Profitivas. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
