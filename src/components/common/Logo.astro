---
export interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 22 } = Astro.props;
---

<!-- Profitivas Geometric Brand Mark: Minimal, precision-balanced geometric glyph -->
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`shrink-0 select-none text-[var(--text-primary)] transition-transform duration-150 group-hover:scale-105 ${className}`}
  aria-hidden="true"
>
  <!-- Outer precision geometric polygon -->
  <path
    d="M12 2.5L20.5 7.4V16.6L12 21.5L3.5 16.6V7.4L12 2.5Z"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linejoin="round"
  />
  <!-- Inner intersecting financial equilibrium lines: Delta growth & leverage balance -->
  <path
    d="M12 2.5V12M12 12L20.5 16.6M12 12L3.5 16.6"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linejoin="round"
    stroke-linecap="round"
    stroke-opacity="0.85"
  />
  <!-- Central precision core node -->
  <circle cx="12" cy="12" r="1.8" fill="currentColor" />
</svg>
