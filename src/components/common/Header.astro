---
import { Search, Menu, X } from 'lucide-astro';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import LanguageSelector from './LanguageSelector.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations, type SupportedLocale } from '../../lib/i18n';

export interface Props {
  locale?: SupportedLocale;
}

const currentLocale = Astro.props.locale || getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const t = useTranslations(currentLocale);

const navItems = [
  { label: t.nav.calculators, href: getLocalizedPath('/calculators', currentLocale) },
  { label: t.nav.categories, href: `${getLocalizedPath('/calculators', currentLocale)}#categories` },
  { label: t.nav.resources, href: getLocalizedPath('/calculators', currentLocale) },
  { label: t.nav.about, href: getLocalizedPath('/about', currentLocale) },
];
---

<header class="border-b border-[var(--border)] bg-[var(--background)]/85 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 sm:h-18 flex items-center justify-between">
    <!-- Brand & Desktop Navigation -->
    <div class="flex items-center gap-6 sm:gap-8">
      <a
        href={getLocalizedPath('/', currentLocale)}
        class="group flex items-center gap-2 text-[var(--text-primary)] font-bold text-base tracking-tight hover:opacity-90 transition-opacity"
        aria-label="Profitivas Home"
      >
        <Logo size={22} />
        <span>Profitivas</span>
      </a>

      <!-- Primary Navigation Links (Desktop) -->
      <nav class="hidden md:flex items-center gap-5 lg:gap-6" aria-label="Main Navigation">
        {navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <a
              href={item.href}
              class={`text-xs transition-colors duration-150 ${
                isActive
                  ? 'text-[var(--text-primary)] font-medium'
                  : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Right Controls: Search, Language Picker, Theme Toggle, and Mobile Menu Button -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <!-- Quiet Desktop Search Trigger -->
      <button
        type="button"
        id="header-search-btn"
        class="hidden sm:inline-flex items-center gap-2 px-2.5 py-1.5 rounded-md text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-elevated)] transition-colors cursor-pointer"
        aria-label={t.actions.searchCalculators}
      >
        <Search class="w-3.5 h-3.5 text-[var(--text-muted)]" />
        <span>{t.actions.searchCalculators.replace('...', '')}</span>
        <kbd class="hidden lg:inline-flex items-center px-1 text-[10px] font-mono text-[var(--text-muted)]">
          ⌘K
        </kbd>
      </button>

      <!-- Language Selector (Desktop) -->
      <div class="hidden sm:inline-flex">
        <LanguageSelector currentLocale={currentLocale} />
      </div>

      <!-- Theme Toggle (Utility Control) -->
      <ThemeToggle />

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex md:hidden items-center justify-center w-8 h-8 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-elevated)] transition-colors cursor-pointer focus:outline-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
      >
        <Menu id="mobile-menu-open-icon" class="w-4 h-4 block" />
        <X id="mobile-menu-close-icon" class="w-4 h-4 hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Lightweight Overlay Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden border-t border-[var(--border)] bg-[var(--background)] px-4 sm:px-6 py-4 transition-all"
    aria-label="Mobile Navigation Drawer"
  >
    <nav class="flex flex-col space-y-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] py-1.5 transition-colors"
        >
          {item.label}
        </a>
      ))}
      <button
        type="button"
        id="mobile-search-btn"
        class="inline-flex items-center gap-2 text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] py-1.5 transition-colors text-left cursor-pointer"
      >
        <Search class="w-3.5 h-3.5 text-[var(--text-muted)]" />
        <span>{t.actions.searchCalculators}</span>
      </button>

      <!-- Mobile Language Selector in Drawer -->
      <div class="pt-2 border-t border-[var(--border)]">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)] block mb-1.5">
          {t.actions.selectLanguage}
        </span>
        <LanguageSelector currentLocale={currentLocale} isMobile={true} />
      </div>
    </nav>
  </div>
</header>

<script>
  function setupHeaderInteractions() {
    function triggerCalculatorSearch() {
      const pickerDialog = document.getElementById('calc-picker-dialog');
      if (pickerDialog) {
        window.dispatchEvent(new CustomEvent('profitivas:open-picker'));
      } else {
        const localeMatch = window.location.pathname.match(/^\/(es|fr|de|pt|it|ja|ko)/);
        const prefix = localeMatch ? localeMatch[0] : '';
        window.location.href = `${prefix}/calculators`;
      }
    }

    const headerSearchBtn = document.getElementById('header-search-btn');
    const mobileSearchBtn = document.getElementById('mobile-search-btn');

    headerSearchBtn?.addEventListener('click', triggerCalculatorSearch);

    // Mobile Menu Controller
    const menuBtn = document.getElementById('mobile-menu-btn');
    const navMenu = document.getElementById('mobile-nav-menu');
    const openIcon = document.getElementById('mobile-menu-open-icon');
    const closeIcon = document.getElementById('mobile-menu-close-icon');

    function closeMobileMenu() {
      menuBtn?.setAttribute('aria-expanded', 'false');
      navMenu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    function toggleMobileMenu() {
      const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;

      menuBtn?.setAttribute('aria-expanded', String(nextState));
      if (nextState) {
        navMenu?.classList.remove('hidden');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        closeMobileMenu();
      }
    }

    menuBtn?.addEventListener('click', toggleMobileMenu);

    mobileSearchBtn?.addEventListener('click', () => {
      closeMobileMenu();
      triggerCalculatorSearch();
    });

    const mobileLinks = navMenu?.querySelectorAll('.mobile-nav-link');
    mobileLinks?.forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu();
      }
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        triggerCalculatorSearch();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderInteractions);
  } else {
    setupHeaderInteractions();
  }
  document.addEventListener('astro:page-load', setupHeaderInteractions);
</script>
