        }
      }

      const docComputerGenNotice = document.getElementById('doc-computer-gen-notice');
      if (docComputerGenNotice) {
        docComputerGenNotice.classList.toggle('hidden', hasSig);
      }

      if (docExecutionRow) {
        const hasLegal = hasDeclaration || hasJurisdiction;
        docExecutionRow.classList.toggle('hidden', !hasLegal && !hasSig);
      }
