    function updateVisibilityToggles() {
      // Document Custom Title
      if (docCustomTitleWrap) {
        docCustomTitleWrap.classList.toggle('hidden', state.documentType !== 'custom');
      }

      // Seller fields visibility
      document.getElementById('seller-tax-wrap')?.classList.toggle('hidden', !state.sellerTaxId?.trim());
      document.getElementById('seller-pan-wrap')?.classList.toggle('hidden', !state.sellerPan?.trim());
      document.getElementById('seller-phone-wrap')?.classList.toggle('hidden', !state.sellerPhone?.trim());
      document.getElementById('seller-state-wrap')?.classList.toggle('hidden', !state.sellerState?.trim() && !state.sellerStateCode?.trim());
      document.getElementById('seller-web-wrap')?.classList.toggle('hidden', !state.sellerWebsite?.trim());

      // Customer fields visibility
      document.getElementById('customer-address-wrap')?.classList.toggle('hidden', !state.customerAddress?.trim());
      document.getElementById('customer-tax-wrap')?.classList.toggle('hidden', !state.customerTaxId?.trim());
      document.getElementById('customer-pan-wrap')?.classList.toggle('hidden', !state.customerPan?.trim());
      document.getElementById('customer-contact-wrap')?.classList.toggle('hidden', !state.customerEmail?.trim() && !state.customerPhone?.trim());
      document.getElementById('customer-state-wrap')?.classList.toggle('hidden', !state.customerState?.trim() && !state.customerStateCode?.trim());

      // Shipping
      if (shippingFieldsWrap) {
        shippingFieldsWrap.classList.toggle('hidden', !state.shippingEnabled);
      }

      // Details
      document.getElementById('place-of-supply-wrap')?.classList.toggle('hidden', !state.placeOfSupply?.trim() && !state.placeOfSupplyCode?.trim());
      document.getElementById('order-ref-wrap')?.classList.toggle('hidden', !state.refOrderNumber?.trim() && !state.refOrderDate?.trim() && !state.sectionsConfig?.references);
      document.getElementById('quote-ref-wrap')?.classList.toggle('hidden', !state.refQuoteNumber?.trim() && !state.refQuoteDate?.trim() && !state.sectionsConfig?.references);

      // Tax Panels
      if (customTaxPanel) customTaxPanel.classList.toggle('hidden', state.taxMode !== 'custom');
      if (indianGstPanel) indianGstPanel.classList.toggle('hidden', state.taxMode !== 'gst');

      // Banking & Legal
      const hasBankFields = Boolean(state.bankDetailsEnabled || state.bankName?.trim() || state.bankAccountNumber?.trim() || state.bankUpiId?.trim() || state.paymentTerms?.trim());
      if (bankingFieldsWrap) {
        bankingFieldsWrap.classList.toggle('hidden', !hasBankFields);
      }
      document.getElementById('notes-wrap')?.classList.toggle('hidden', !state.notes?.trim());
      const isTermsEnabled = Boolean(state.sectionsConfig?.terms);
      document.getElementById('terms-disabled-view')?.classList.toggle('hidden', isTermsEnabled);
      document.getElementById('terms-wrap')?.classList.toggle('hidden', !isTermsEnabled);
      document.getElementById('declaration-wrap')?.classList.toggle('hidden', !state.declaration?.trim());
      document.getElementById('jurisdiction-wrap')?.classList.toggle('hidden', !state.jurisdiction?.trim());
      document.getElementById('signatory-wrap')?.classList.toggle('hidden', !state.signatoryEnabled && !state.signatoryName?.trim() && !state.signatoryDesignation?.trim());
    }

    function updateLogoDisplay() {
      if (state.sellerLogo) {
        if (logoPreviewThumbWrap) logoPreviewThumbWrap.classList.remove('hidden');
        if (logoPreviewThumb) logoPreviewThumb.src = state.sellerLogo;
        if (btnRemoveLogo) btnRemoveLogo.classList.remove('hidden');
        if (docLogoWrap) docLogoWrap.classList.remove('hidden');
        if (docLogoImg) docLogoImg.src = state.sellerLogo;
      } else {
        if (logoPreviewThumbWrap) logoPreviewThumbWrap.classList.add('hidden');
        if (logoPreviewThumb) logoPreviewThumb.src = '';
        if (btnRemoveLogo) btnRemoveLogo.classList.add('hidden');
        if (docLogoWrap) docLogoWrap.classList.add('hidden');
        if (docLogoImg) docLogoImg.src = '';
      }
    }

    // Render Line Items in Form Editor
    function renderEditorLineItems() {
      if (!lineItemsContainer) return;
      lineItemsContainer.innerHTML = '';

      const showIndex = state.tableColumns.index !== false;
      const showHsn = !!state.tableColumns.hsn;
      const showUnit = !!state.tableColumns.unit;
      const showQty = state.tableColumns.qty !== false;
      const showRate = state.tableColumns.rate !== false;
      const showDisc = !!state.tableColumns.discount;
      const showTax = !!state.tableColumns.tax;

      state.items.forEach((item, index) => {
        const row = document.createElement('div');
        row.className = 'p-3.5 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] space-y-3';
        row.setAttribute('data-id', item.id);

        const hsnVal = item.hsnSac || '';
        const unitVal = item.unit || '';
        const discVal = item.discountPercent != null ? item.discountPercent : 0;
        const taxVal = item.taxPercent != null ? item.taxPercent : 0;

        row.innerHTML = `
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-mono text-[var(--text-muted)] ${showIndex ? '' : 'hidden'}">#${index + 1}</span>
            ${
              state.items.length > 1
                ? `<button type="button" class="btn-remove-item p-1 text-[var(--text-muted)] hover:text-[var(--negative-text)] transition-colors cursor-pointer" data-id="${item.id}" title="Remove item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                  </button>`
                : ''
            }
          </div>
          <div class="space-y-1">
            <input
              type="text"
              class="item-desc-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
              placeholder="Description of item or service"
              value="${item.description.replace(/"/g, '&quot;')}"
              data-id="${item.id}"
            />
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <div class="${showQty ? '' : 'hidden'}">
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Qty</label>
              <input
                type="number"
                min="0"
                step="any"
                class="item-qty-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
                value="${item.quantity}"
                data-id="${item.id}"
              />
            </div>
            <div class="${showRate ? '' : 'hidden'}">
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Rate</label>
              <input
                type="number"
                min="0"
                step="any"
                class="item-price-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
                value="${item.unitPrice}"
                data-id="${item.id}"
              />
            </div>
            <div class="${showHsn ? '' : 'hidden'}">
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">HSN/SAC</label>
              <input
                type="text"
                class="item-hsn-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="e.g. 8501"
                value="${hsnVal.replace(/"/g, '&quot;')}"
                data-id="${item.id}"
              />
            </div>
            <div class="${showUnit ? '' : 'hidden'}">
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Unit</label>
              <input
                type="text"
                class="item-unit-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="pcs / hrs / nos"
                value="${unitVal.replace(/"/g, '&quot;')}"
                data-id="${item.id}"
              />
            </div>
            <div class="${showDisc ? '' : 'hidden'}">
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Disc %</label>
              <input
                type="number"
                min="0"
                max="100"
                step="any"
                class="item-disc-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
                value="${discVal}"
                data-id="${item.id}"
              />
            </div>
            <div class="${showTax ? '' : 'hidden'}">
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Tax %</label>
              <input
                type="number"
                min="0"
                max="100"
                step="any"
                class="item-tax-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
                value="${taxVal}"
                data-id="${item.id}"
              />
            </div>
          </div>
        `;

        lineItemsContainer.appendChild(row);
      });

      // Bind input handlers
      lineItemsContainer.querySelectorAll('.item-desc-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            it.description = target.value;
            isSampleActive = false;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-qty-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            const parsed = parseFloat(target.value);
            it.quantity = isNaN(parsed) || parsed < 0 ? 0 : parsed;
            isSampleActive = false;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-price-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            const parsed = parseFloat(target.value);
            it.unitPrice = isNaN(parsed) || parsed < 0 ? 0 : parsed;
            isSampleActive = false;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-hsn-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            it.hsnSac = target.value;
            isSampleActive = false;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-unit-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            it.unit = target.value;
            isSampleActive = false;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-disc-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            const parsed = parseFloat(target.value);
            it.discountPercent = isNaN(parsed) || parsed < 0 ? 0 : Math.min(100, parsed);
            isSampleActive = false;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-tax-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            const parsed = parseFloat(target.value);
            it.taxPercent = isNaN(parsed) || parsed < 0 ? 0 : Math.min(100, parsed);
            isSampleActive = false;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.btn-remove-item').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (state.items.length > 1) {
            state.items = state.items.filter((x) => x.id !== target);
            renderEditorLineItems();
            updatePreview();
            saveToStorage();
          }
        });
      });
    }

    // Get Document Title
    function getDisplayTitle(docType: DocumentType): string {
      if (docType === 'custom' && state.customTitle?.trim()) {
        return state.customTitle.trim().toUpperCase();
      }
      const titleMap: Record<DocumentType, string> = {
        invoice: 'TAX INVOICE',
        quotation: 'QUOTATION',
        proforma: 'PROFORMA INVOICE',
        estimate: 'COST ESTIMATE',
        purchase_order: 'PURCHASE ORDER',
        receipt: 'PAYMENT RECEIPT',
        credit_note: 'CREDIT NOTE',
        debit_note: 'DEBIT NOTE',
        delivery_challan: 'DELIVERY CHALLAN',
        custom: 'COMMERCIAL DOCUMENT',
      };
      return titleMap[docType] || 'INVOICE';
    }

    // Update Live Document Preview (Zero Visual Footprint)
    function updatePreview() {
      // Apply layout and density preset classes to paperSheet
      if (paperSheet) {
        paperSheet.classList.remove(
          'doc-layout-classic',
          'doc-layout-modern',
          'doc-layout-minimal',
          'doc-layout-compact',
          'doc-density-comfortable',
          'doc-density-compact'
        );
        paperSheet.classList.add(`doc-layout-${state.layout || 'classic'}`);
        paperSheet.classList.add(`doc-density-${state.density || 'comfortable'}`);
      }

      // 1. Watermark Sample Badge
      if (docSampleBadge) {
        docSampleBadge.classList.toggle('hidden', !isSampleActive);
      }

      // Copy Label
      if (docCopyLabel) {
        if (state.copyLabel?.trim()) {
          docCopyLabel.textContent = state.copyLabel.trim();
          docCopyLabel.classList.remove('hidden');
        } else {
          docCopyLabel.textContent = '';
          docCopyLabel.classList.add('hidden');
        }
      }

      // 2. Document Title & Contextual Labels
      const displayTitle = getDisplayTitle(state.documentType);
      if (docTitle) docTitle.textContent = displayTitle;

      const isQuoteOrEstimate = state.documentType === 'quotation' || state.documentType === 'estimate';
      const isReceipt = state.documentType === 'receipt';

      if (docNumberLabel) {
        docNumberLabel.textContent = isReceipt ? 'Receipt No.:' : isQuoteOrEstimate ? 'Quote No.:' : 'Doc No.:';
      }
      if (docInvoiceNumber) {
        docInvoiceNumber.textContent = state.documentNumber || 'DOC-001';
      }
      if (docInvoiceDate) {
        docInvoiceDate.textContent = state.documentDate || todayDateStr;
      }

      // Due Date vs Valid Until
      if (docDueDateLabel) {
        docDueDateLabel.textContent = isQuoteOrEstimate ? 'Valid Until:' : 'Due Date:';
      }
      if (dueDateLabel) {
        dueDateLabel.textContent = isQuoteOrEstimate ? 'Valid Until' : 'Due Date';
      }

      if (docDueDateRow && docInvoiceDueDate) {
        if (isReceipt) {
          docDueDateRow.classList.add('hidden');
        } else {
          docDueDateRow.classList.remove('hidden');
          docInvoiceDueDate.textContent = state.dueDate || '';
        }
      }

      // Place of Supply
      if (docPlaceSupplyRow && docPlaceSupplyVal) {
        if (state.placeOfSupply?.trim()) {
          const codePart = state.placeOfSupplyCode?.trim() ? ` (${state.placeOfSupplyCode.trim()})` : '';
          docPlaceSupplyVal.textContent = `${state.placeOfSupply.trim()}${codePart}`;
          docPlaceSupplyRow.classList.remove('hidden');
        } else {
          docPlaceSupplyRow.classList.add('hidden');
        }
      }

      // Payment terms
      if (docPaymentTermsWrap && docPaymentTerms) {
        if (state.paymentTerms?.trim()) {
          docPaymentTerms.textContent = state.paymentTerms.trim();
          docPaymentTermsWrap.classList.remove('hidden');
        } else {
          docPaymentTermsWrap.classList.add('hidden');
        }
      }

      // 3. Supplier Details (Zero footprint on empty)
      if (docSellerName) {
        docSellerName.textContent = state.sellerName?.trim() || '';
        docSellerName.classList.toggle('hidden', !state.sellerName?.trim());
      }
      if (docSellerAddress) {
        docSellerAddress.textContent = state.sellerAddress?.trim() || '';
        docSellerAddress.classList.toggle('hidden', !state.sellerAddress?.trim());
      }
      if (docSellerEmail) {
        docSellerEmail.textContent = state.sellerEmail?.trim() || '';
        docSellerEmail.classList.toggle('hidden', !state.sellerEmail?.trim());
      }
      if (docSellerPhone) {
        docSellerPhone.textContent = state.sellerPhone?.trim() ? `Ph: ${state.sellerPhone.trim()}` : '';
        docSellerPhone.classList.toggle('hidden', !state.sellerPhone?.trim());
      }
      if (docSellerTaxId) {
        docSellerTaxId.textContent = state.sellerTaxId?.trim() ? `GSTIN/Tax ID: ${state.sellerTaxId.trim()}` : '';
        docSellerTaxId.classList.toggle('hidden', !state.sellerTaxId?.trim());
      }
      if (docSellerPan) {
        docSellerPan.textContent = state.sellerPan?.trim() ? `PAN: ${state.sellerPan.trim()}` : '';
        docSellerPan.classList.toggle('hidden', !state.sellerPan?.trim());
      }
      if (docSellerState) {
        const sc = state.sellerStateCode?.trim() ? ` (Code: ${state.sellerStateCode.trim()})` : '';
        docSellerState.textContent = state.sellerState?.trim() ? `State: ${state.sellerState.trim()}${sc}` : '';
        docSellerState.classList.toggle('hidden', !state.sellerState?.trim());
      }
      if (docSellerWebsite) {
        docSellerWebsite.textContent = state.sellerWebsite?.trim() || '';
        docSellerWebsite.classList.toggle('hidden', !state.sellerWebsite?.trim());
      }

      // 4. Customer / Bill To (Zero footprint)
      if (docCustomerCompany) {
        docCustomerCompany.textContent = state.customerCompany?.trim() || '';
        docCustomerCompany.classList.toggle('hidden', !state.customerCompany?.trim());
      }
      if (docCustomerName) {
        docCustomerName.textContent = state.customerName?.trim() ? `Attn: ${state.customerName.trim()}` : '';
        docCustomerName.classList.toggle('hidden', !state.customerName?.trim());
      }
      if (docCustomerAddress) {
        docCustomerAddress.textContent = state.customerAddress?.trim() || '';
        docCustomerAddress.classList.toggle('hidden', !state.customerAddress?.trim());
      }
      if (docCustomerEmail) {
        docCustomerEmail.textContent = state.customerEmail?.trim() || '';
        docCustomerEmail.classList.toggle('hidden', !state.customerEmail?.trim());
      }
      if (docCustomerPhone) {
        docCustomerPhone.textContent = state.customerPhone?.trim() ? `Ph: ${state.customerPhone.trim()}` : '';
        docCustomerPhone.classList.toggle('hidden', !state.customerPhone?.trim());
      }
      if (docCustomerTaxId) {
        docCustomerTaxId.textContent = state.customerTaxId?.trim() ? `GSTIN/Tax ID: ${state.customerTaxId.trim()}` : '';
        docCustomerTaxId.classList.toggle('hidden', !state.customerTaxId?.trim());
      }
      if (docCustomerPan) {
        docCustomerPan.textContent = state.customerPan?.trim() ? `PAN: ${state.customerPan.trim()}` : '';
        docCustomerPan.classList.toggle('hidden', !state.customerPan?.trim());
      }
      if (docCustomerState) {
        const csc = state.customerStateCode?.trim() ? ` (Code: ${state.customerStateCode.trim()})` : '';
        docCustomerState.textContent = state.customerState?.trim() ? `State: ${state.customerState.trim()}${csc}` : '';
        docCustomerState.classList.toggle('hidden', !state.customerState?.trim());
      }

      // 5. Shipping / Consignee Card (Adaptive Bill To / Ship To grid)
      const hasShipping =
        (state.shippingEnabled || state.sectionsConfig?.shipping) &&
        (state.shippingName?.trim() || state.shippingAddress?.trim() || state.shippingDestination?.trim());

      if (docBillToCard) {
        docBillToCard.classList.toggle('sm:col-span-2', !hasShipping);
      }

      if (docShipToCard) {
        if (hasShipping) {
          docShipToCard.classList.remove('hidden');
          if (docShipName) {
            docShipName.textContent = state.shippingName?.trim() || '';
            docShipName.classList.toggle('hidden', !state.shippingName?.trim());
          }
          if (docShipAddress) {
            docShipAddress.textContent = state.shippingAddress?.trim() || '';
            docShipAddress.classList.toggle('hidden', !state.shippingAddress?.trim());
          }
          if (docShipDestination) {
            docShipDestination.textContent = state.shippingDestination?.trim() ? `Destination: ${state.shippingDestination.trim()}` : '';
            docShipDestination.classList.toggle('hidden', !state.shippingDestination?.trim());
          }
          if (docShipTaxId) {
            docShipTaxId.textContent = state.shippingTaxId?.trim() ? `GSTIN: ${state.shippingTaxId.trim()}` : '';
            docShipTaxId.classList.toggle('hidden', !state.shippingTaxId?.trim());
          }
        } else {
          docShipToCard.classList.add('hidden');
        }
      }

      // 6. Order / PO References Strip
      let hasReferences = false;
      const refEnabled = state.sectionsConfig?.references !== false;
      if (refEnabled && state.refOrderNumber?.trim()) {
        hasReferences = true;
        docRefOrder?.classList.remove('hidden');
        if (docRefOrderVal) docRefOrderVal.textContent = state.refOrderNumber.trim();
      } else {
        docRefOrder?.classList.add('hidden');
      }

      if (refEnabled && state.refOrderDate?.trim()) {
        hasReferences = true;
        docRefOrderDate?.classList.remove('hidden');
        if (docRefOrderDateVal) docRefOrderDateVal.textContent = state.refOrderDate.trim();
      } else {
        docRefOrderDate?.classList.add('hidden');
      }

      if (refEnabled && state.refQuoteNumber?.trim()) {
        hasReferences = true;
        docRefQuote?.classList.remove('hidden');
        if (docRefQuoteVal) docRefQuoteVal.textContent = state.refQuoteNumber.trim();
      } else {
        docRefQuote?.classList.add('hidden');
      }

      if (refEnabled && state.refQuoteDate?.trim()) {
        hasReferences = true;
        docRefQuoteDate?.classList.remove('hidden');
        if (docRefQuoteDateVal) docRefQuoteDateVal.textContent = state.refQuoteDate.trim();
      } else {
        docRefQuoteDate?.classList.add('hidden');
      }

      if (docReferencesStrip) {
        docReferencesStrip.classList.toggle('hidden', !hasReferences);
      }

      // 7. Dynamic Table Columns & Calculations
      if (!docItemsTbody) return;
      docItemsTbody.innerHTML = '';

      // Check if columns should be shown based on state.tableColumns or item values
      const showIndex = state.tableColumns?.index !== false;
      const showHsn = !!state.tableColumns?.hsn || state.items.some((it) => !!it.hsnSac?.trim());
      const showUnit = !!state.tableColumns?.unit || state.items.some((it) => !!it.unit?.trim());
      const showQty = state.tableColumns?.qty !== false;
      const showRate = state.tableColumns?.rate !== false;
      const showDiscount = !!state.tableColumns?.discount || state.items.some((it) => it.discountPercent != null && it.discountPercent > 0);
      const isTaxActive = !!state.tableColumns?.tax || state.taxMode !== 'none';
      const showAmount = state.tableColumns?.amount !== false;

      // Toggle Header Columns
      if (thIndex) thIndex.classList.toggle('hidden', !showIndex);
      if (thHsn) thHsn.classList.toggle('hidden', !showHsn);
      if (thUnit) thUnit.classList.toggle('hidden', !showUnit);
      if (thQty) thQty.classList.toggle('hidden', !showQty);
      if (thPrice) thPrice.classList.toggle('hidden', !showRate);
      if (thDiscount) thDiscount.classList.toggle('hidden', !showDiscount);
      if (thTax) thTax.classList.toggle('hidden', !isTaxActive);
      if (thAmount) thAmount.classList.toggle('hidden', !showAmount);

      let subtotalSum = 0;
      let discountSum = 0;
      let taxableSum = 0;
      let taxSum = 0;

      // Rate for Indian GST
      const globalGstRate = parseFloat(gstRateInput?.value || '18') || 18;
      const customTaxRate = parseFloat(customTaxRateInput?.value || '18') || 18;

      state.items.forEach((item, idx) => {
        const qty = Number.isFinite(item.quantity) && item.quantity >= 0 ? item.quantity : 0;
        const price = Number.isFinite(item.unitPrice) && item.unitPrice >= 0 ? item.unitPrice : 0;
        const discPct = item.discountPercent != null && Number.isFinite(item.discountPercent) && item.discountPercent >= 0 ? item.discountPercent : 0;

        let effectiveTaxPct = 0;
        if (state.taxMode === 'gst') {
          effectiveTaxPct = item.taxPercent && item.taxPercent > 0 ? item.taxPercent : globalGstRate;
        } else if (state.taxMode === 'custom') {
          effectiveTaxPct = item.taxPercent && item.taxPercent > 0 ? item.taxPercent : customTaxRate;
        }

        const rawLineSubtotal = qty * price;
        const lineDiscount = rawLineSubtotal * (discPct / 100);
        const lineTaxable = Math.max(0, rawLineSubtotal - lineDiscount);
        const lineTax = isTaxActive ? lineTaxable * (effectiveTaxPct / 100) : 0;
        const lineTotal = lineTaxable + lineTax;

        subtotalSum += rawLineSubtotal;
        discountSum += lineDiscount;
        taxableSum += lineTaxable;
        taxSum += lineTax;

        const tr = document.createElement('tr');
        tr.className = 'text-neutral-800';

        tr.innerHTML = `
          ${showIndex ? `<td class="py-2.5 pr-2 font-mono text-xs text-neutral-400 align-top">${idx + 1}</td>` : ''}
          <td class="py-2.5 px-2.5 font-normal text-neutral-900 align-top text-sm leading-relaxed">
            ${item.description ? item.description.replace(/\n/g, '<br/>') : '<span class="text-neutral-300">—</span>'}
          </td>
          ${showHsn ? `<td class="py-2.5 px-2.5 text-right font-mono text-xs sm:text-[13px] text-neutral-600 align-top">${item.hsnSac || '—'}</td>` : ''}
          ${showUnit ? `<td class="py-2.5 px-2.5 text-right text-xs sm:text-sm text-neutral-600 align-top">${item.unit || '—'}</td>` : ''}
          ${showQty ? `<td class="py-2.5 px-2.5 text-right font-mono tabular-nums text-sm text-neutral-900 align-top">${qty}</td>` : ''}
          ${showRate ? `<td class="py-2.5 px-2.5 text-right font-mono tabular-nums text-sm text-neutral-900 align-top">${formatMoney(price, state.currency)}</td>` : ''}
          ${showDiscount ? `<td class="py-2.5 px-2.5 text-right font-mono tabular-nums text-xs sm:text-sm text-neutral-600 align-top">${discPct > 0 ? `${discPct}%` : '—'}</td>` : ''}
          ${isTaxActive ? `<td class="py-2.5 px-2.5 text-right font-mono tabular-nums text-xs sm:text-sm text-neutral-600 align-top">${effectiveTaxPct > 0 ? `${effectiveTaxPct}%` : '—'}</td>` : ''}
          ${showAmount ? `<td class="py-2.5 pl-2.5 text-right font-mono font-semibold text-sm text-neutral-900 tabular-nums align-top">${formatMoney(lineTotal, state.currency)}</td>` : ''}
        `;

        docItemsTbody.appendChild(tr);
      });

      // 8. Totals Breakdown
      if (docSubtotalVal) docSubtotalVal.textContent = formatMoney(subtotalSum, state.currency);

      if (docDiscountRow && docDiscountVal) {
        if (discountSum > 0) {
          docDiscountRow.classList.remove('hidden');
          docDiscountVal.textContent = `-${formatMoney(discountSum, state.currency)}`;
        } else {
          docDiscountRow.classList.add('hidden');
        }
      }

      if (docTaxableRow && docTaxableVal) {
        if (isTaxActive && discountSum > 0) {
          docTaxableRow.classList.remove('hidden');
          docTaxableVal.textContent = formatMoney(taxableSum, state.currency);
        } else {
          docTaxableRow.classList.add('hidden');
        }
      }

      // Tax Splits (CGST + SGST vs IGST vs Custom)
      if (docCgstRow) docCgstRow.classList.add('hidden');
      if (docSgstRow) docSgstRow.classList.add('hidden');
      if (docIgstRow) docIgstRow.classList.add('hidden');
      if (docCustomTaxRow) docCustomTaxRow.classList.add('hidden');

      if (state.taxMode === 'gst') {
        const isIntra = state.gstSupplyType === 'cgst_sgst';
        const rateLabel = globalGstRate;

        if (isIntra) {
          const halfRate = rateLabel / 2;
          const halfTax = taxSum / 2;
          if (docCgstRow && docCgstVal && docCgstLabel) {
            docCgstLabel.textContent = `CGST (${halfRate}%)`;
            docCgstVal.textContent = formatMoney(halfTax, state.currency);
            docCgstRow.classList.remove('hidden');
          }
          if (docSgstRow && docSgstVal && docSgstLabel) {
            docSgstLabel.textContent = `SGST (${halfRate}%)`;
            docSgstVal.textContent = formatMoney(halfTax, state.currency);
            docSgstRow.classList.remove('hidden');
          }
        } else {
          if (docIgstRow && docIgstVal && docIgstLabel) {
            docIgstLabel.textContent = `IGST (${rateLabel}%)`;
            docIgstVal.textContent = formatMoney(taxSum, state.currency);
            docIgstRow.classList.remove('hidden');
          }
        }
      } else if (state.taxMode === 'custom') {
        if (docCustomTaxRow && docCustomTaxVal && docCustomTaxLabel) {
          docCustomTaxLabel.textContent = `Tax (${customTaxRate}%)`;
          docCustomTaxVal.textContent = formatMoney(taxSum, state.currency);
          docCustomTaxRow.classList.remove('hidden');
        }
      }

      let rawTotal = taxableSum + taxSum;
      let roundOffDiff = 0;

      if (state.enableRoundOff) {
        const roundedTotal = Math.round(rawTotal);
        roundOffDiff = roundedTotal - rawTotal;
        rawTotal = roundedTotal;
      }

      if (docRoundOffRow && docRoundOffVal) {
        if (state.enableRoundOff && Math.abs(roundOffDiff) >= 0.005) {
          docRoundOffRow.classList.remove('hidden');
          docRoundOffVal.textContent = `${roundOffDiff >= 0 ? '+' : ''}${formatMoney(roundOffDiff, state.currency)}`;
        } else {
          docRoundOffRow.classList.add('hidden');
        }
      }

      const finalTotal = Math.max(0, rawTotal);
      if (docTotalVal) docTotalVal.textContent = formatMoney(finalTotal, state.currency);

      if (docReverseChargeNotice) {
        docReverseChargeNotice.classList.toggle('hidden', !state.reverseCharge);
      }

      // 9. Amount in Words
      if (docAmountInWordsWrap && docAmountInWordsVal) {
        if (finalTotal > 0) {
          const inWords = formatAmountInWords(finalTotal, state.currency);
          docAmountInWordsVal.textContent = inWords;
          docAmountInWordsWrap.classList.remove('hidden');
        } else {
          docAmountInWordsWrap.classList.add('hidden');
        }
      }

      // 10. Payment Details & Notes Row (Side-by-side 2-column grid when both active)
      const hasBank = Boolean(
        state.bankDetailsEnabled &&
        state.sectionsConfig?.payment !== false &&
        (state.bankName?.trim() || state.bankAccountNumber?.trim() || state.bankUpiId?.trim())
      );
      const hasNotes = Boolean(state.sectionsConfig?.notes !== false && state.notes?.trim());

      if (docPaymentNotesRow) {
        docPaymentNotesRow.classList.toggle('hidden', !hasBank && !hasNotes);
      }

      if (docBankBox) {
        if (hasBank) {
          docBankBox.classList.remove('hidden');
          docBankBox.classList.toggle('sm:col-span-2', !hasNotes);
          if (docBankLineName) {
            docBankLineName.textContent = state.bankName ? `Bank: ${state.bankName.trim()}` : '';
            docBankLineName.classList.toggle('hidden', !state.bankName?.trim());
          }
          if (docBankLineAcct) {
            docBankLineAcct.textContent = state.bankAccountNumber ? `A/C: ${state.bankAccountNumber.trim()}` : '';
            docBankLineAcct.classList.toggle('hidden', !state.bankAccountNumber?.trim());
          }
          if (docBankLineIfsc) {
            docBankLineIfsc.textContent = state.bankIfsc ? `IFSC/Routing: ${state.bankIfsc.trim()}` : '';
            docBankLineIfsc.classList.toggle('hidden', !state.bankIfsc?.trim());
          }
          if (docBankLineUpi) {
            docBankLineUpi.textContent = state.bankUpiId ? `UPI: ${state.bankUpiId.trim()}` : '';
            docBankLineUpi.classList.toggle('hidden', !state.bankUpiId?.trim());
          }
        } else {
          docBankBox.classList.add('hidden');
        }
      }

      if (docNotesBox && docNotesVal) {
        if (hasNotes && state.notes?.trim()) {
          docNotesVal.textContent = state.notes.trim();
          docNotesBox.classList.remove('hidden');
          docNotesBox.classList.toggle('sm:col-span-2', !hasBank);
        } else {
          docNotesBox.classList.add('hidden');
        }
      }

      // 11. Terms and Conditions Row (Zero footprint if empty or disabled)
      const hasTerms = Boolean(state.sectionsConfig?.terms && state.termsAndConditions?.trim());
      if (docTermsRow) {
        docTermsRow.classList.toggle('hidden', !hasTerms);
      }
      if (docTermsBox && docTermsVal) {
        if (hasTerms && state.termsAndConditions?.trim()) {
          docTermsVal.textContent = state.termsAndConditions.trim();
          docTermsBox.classList.remove('hidden');
        } else {
          docTermsBox.classList.add('hidden');
          docTermsVal.textContent = '';
        }
      }

      // 12. Execution Row: Declaration, Jurisdiction, Notice on Left; Signatory on Right
      const hasDeclaration = Boolean(state.sectionsConfig?.declaration !== false && state.declaration?.trim());
      if (docDeclarationBox && docDeclarationVal) {
        if (hasDeclaration && state.declaration?.trim()) {
          docDeclarationVal.textContent = state.declaration.trim();
          docDeclarationBox.classList.remove('hidden');
        } else {
          docDeclarationBox.classList.add('hidden');
        }
      }

      const hasJurisdiction = Boolean(state.jurisdiction?.trim());
      if (docJurisdictionBox) {
        if (hasJurisdiction && state.jurisdiction?.trim()) {
          docJurisdictionBox.textContent = state.jurisdiction.trim();
          docJurisdictionBox.classList.remove('hidden');
