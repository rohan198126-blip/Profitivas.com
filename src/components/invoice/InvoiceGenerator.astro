<!-- Client-Side Reactive Invoice Engine -->
<script>
  import { SUPPORTED_CURRENCIES } from '../../lib/i18n/invoice';
  import type { InvoiceLineItem } from '../../lib/i18n/invoice/types';

  interface InvoiceState {
    sellerName: string;
    sellerLogo: string;
    sellerAddress: string;
    sellerEmail: string;
    sellerPhone: string;
    sellerTaxId: string;
    sellerWebsite: string;
    customerName: string;
    customerCompany: string;
    customerAddress: string;
    customerEmail: string;
    customerTaxId: string;
    invoiceNumber: string;
    invoiceDate: string;
    dueDate: string;
    currency: string;
    paymentTerms: string;
    items: InvoiceLineItem[];
    notes: string;
  }

  const STORAGE_KEY = 'profitivas_invoice_draft_v1';

  function initInvoiceGenerator() {
    const root = document.getElementById('invoice-generator-root');
    if (!root) return;

    const currentLocale = root.getAttribute('data-locale') || 'en';

    // Default Initial State
    const defaultState: InvoiceState = {
      sellerName: 'Acme Studio Inc.',
      sellerLogo: '',
      sellerAddress: '100 Market St, Suite 400\nSan Francisco, CA 94105',
      sellerEmail: 'billing@acmestudio.com',
      sellerPhone: '+1 (555) 019-2834',
      sellerTaxId: 'US-EIN 12-3456789',
      sellerWebsite: 'https://acmestudio.com',
      customerName: 'Sarah Jenkins',
      customerCompany: 'Venture Brands LLC',
      customerAddress: '450 Broadway Ave, Floor 8\nNew York, NY 10013',
      customerEmail: 'accounting@venturebrands.com',
      customerTaxId: '',
      invoiceNumber: 'INV-2026-001',
      invoiceDate: new Date().toISOString().split('T')[0],
      dueDate: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
      currency: 'USD',
      paymentTerms: 'Net 30',
      items: [
        {
          id: 'item-1',
          description: 'Web Design & Brand Identity Consultation',
          quantity: 1,
          unitPrice: 1500,
          discountPercent: 0,
          taxPercent: 0,
        },
        {
          id: 'item-2',
          description: 'Frontend Development & Performance Optimization',
          quantity: 20,
          unitPrice: 95,
          discountPercent: 5,
          taxPercent: 0,
        },
      ],
      notes: 'Payment is due within 30 days of invoice date. Please transfer to Wire/ACH: Bank of America, Routing #123456789, Account #987654321. Thank you for your business!',
    };

    let state: InvoiceState = { ...defaultState };

    // Restore from localStorage if present
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed && Array.isArray(parsed.items) && parsed.items.length > 0) {
          state = { ...defaultState, ...parsed };
        }
      }
    } catch {
      // Ignore storage errors safely
    }

    function saveToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {
        // Safe catch if quota exceeded
      }
    }

    function getCurrencyConfig(code: string) {
      return SUPPORTED_CURRENCIES.find((c) => c.code === code) || SUPPORTED_CURRENCIES[0];
    }

    function formatMoney(amount: number, currencyCode: string): string {
      if (!Number.isFinite(amount)) return '$0.00';
      const cfg = getCurrencyConfig(currencyCode);
      const decimals = cfg.decimals;

      const localeMap: Record<string, string> = {
        en: 'en-US',
        es: 'es-ES',
        fr: 'fr-FR',
        de: 'de-DE',
        pt: 'pt-BR',
        it: 'it-IT',
        ja: 'ja-JP',
        ko: 'ko-KR',
      };
      const activeIntlLocale = localeMap[currentLocale] || 'en-US';

      try {
        return new Intl.NumberFormat(activeIntlLocale, {
          style: 'currency',
          currency: currencyCode,
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        }).format(amount);
      } catch {
        return `${cfg.symbol}${amount.toFixed(decimals)}`;
      }
    }

    // DOM Elements
    const sellerNameInput = document.getElementById('seller-name') as HTMLInputElement | null;
    const sellerAddressInput = document.getElementById('seller-address') as HTMLTextAreaElement | null;
    const sellerEmailInput = document.getElementById('seller-email') as HTMLInputElement | null;
    const sellerPhoneInput = document.getElementById('seller-phone') as HTMLInputElement | null;
    const sellerTaxIdInput = document.getElementById('seller-tax-id') as HTMLInputElement | null;
    const sellerWebsiteInput = document.getElementById('seller-website') as HTMLInputElement | null;
    const logoFileInput = document.getElementById('logo-file-input') as HTMLInputElement | null;
    const logoPreviewThumbWrap = document.getElementById('logo-preview-thumb-wrap');
    const logoPreviewThumb = document.getElementById('logo-preview-thumb') as HTMLImageElement | null;
    const btnRemoveLogo = document.getElementById('btn-remove-logo');

    const customerCompanyInput = document.getElementById('customer-company') as HTMLInputElement | null;
    const customerNameInput = document.getElementById('customer-name') as HTMLInputElement | null;
    const customerAddressInput = document.getElementById('customer-address') as HTMLTextAreaElement | null;
    const customerEmailInput = document.getElementById('customer-email') as HTMLInputElement | null;
    const customerTaxIdInput = document.getElementById('customer-tax-id') as HTMLInputElement | null;

    const invoiceNumberInput = document.getElementById('invoice-number') as HTMLInputElement | null;
    const invoiceDateInput = document.getElementById('invoice-date') as HTMLInputElement | null;
    const invoiceDueDateInput = document.getElementById('invoice-due-date') as HTMLInputElement | null;
    const invoiceCurrencySelect = document.getElementById('invoice-currency') as HTMLSelectElement | null;
    const invoicePaymentTermsInput = document.getElementById('invoice-payment-terms') as HTMLInputElement | null;
    const invoiceNotesInput = document.getElementById('invoice-notes') as HTMLTextAreaElement | null;

    const lineItemsContainer = document.getElementById('line-items-container');
    const btnAddLineItem = document.getElementById('btn-add-line-item');

    // Document Preview DOM Elements
    const docSellerName = document.getElementById('doc-seller-name');
    const docSellerAddress = document.getElementById('doc-seller-address');
    const docSellerEmail = document.getElementById('doc-seller-email');
    const docSellerPhone = document.getElementById('doc-seller-phone');
    const docSellerTaxId = document.getElementById('doc-seller-tax-id');
    const docLogoWrap = document.getElementById('doc-logo-wrap');
    const docLogoImg = document.getElementById('doc-logo-img') as HTMLImageElement | null;

    const docCustomerCompany = document.getElementById('doc-customer-company');
    const docCustomerName = document.getElementById('doc-customer-name');
    const docCustomerAddress = document.getElementById('doc-customer-address');
    const docCustomerEmail = document.getElementById('doc-customer-email');
    const docCustomerTaxId = document.getElementById('doc-customer-tax-id');

    const docInvoiceNumber = document.getElementById('doc-invoice-number');
    const docInvoiceDate = document.getElementById('doc-invoice-date');
    const docInvoiceDueDate = document.getElementById('doc-invoice-due-date');
    const docPaymentTerms = document.getElementById('doc-payment-terms');
    const docPaymentTermsWrap = document.getElementById('doc-payment-terms-wrap');
    const docNotesText = document.getElementById('doc-notes-text');

    const docItemsTbody = document.getElementById('doc-items-tbody');
    const docSubtotalVal = document.getElementById('doc-subtotal-val');
    const docDiscountRow = document.getElementById('doc-discount-row');
    const docDiscountVal = document.getElementById('doc-discount-val');
    const docTaxRow = document.getElementById('doc-tax-row');
    const docTaxVal = document.getElementById('doc-tax-val');
    const docTotalVal = document.getElementById('doc-total-val');

    // Sync input values to form fields from restored state
    function populateFormFields() {
      if (sellerNameInput) sellerNameInput.value = state.sellerName;
      if (sellerAddressInput) sellerAddressInput.value = state.sellerAddress;
      if (sellerEmailInput) sellerEmailInput.value = state.sellerEmail;
      if (sellerPhoneInput) sellerPhoneInput.value = state.sellerPhone;
      if (sellerTaxIdInput) sellerTaxIdInput.value = state.sellerTaxId;
      if (sellerWebsiteInput) sellerWebsiteInput.value = state.sellerWebsite;

      if (customerCompanyInput) customerCompanyInput.value = state.customerCompany;
      if (customerNameInput) customerNameInput.value = state.customerName;
      if (customerAddressInput) customerAddressInput.value = state.customerAddress;
      if (customerEmailInput) customerEmailInput.value = state.customerEmail;
      if (customerTaxIdInput) customerTaxIdInput.value = state.customerTaxId;

      if (invoiceNumberInput) invoiceNumberInput.value = state.invoiceNumber;
      if (invoiceDateInput) invoiceDateInput.value = state.invoiceDate;
      if (invoiceDueDateInput) invoiceDueDateInput.value = state.dueDate;
      if (invoiceCurrencySelect) invoiceCurrencySelect.value = state.currency;
      if (invoicePaymentTermsInput) invoicePaymentTermsInput.value = state.paymentTerms;
      if (invoiceNotesInput) invoiceNotesInput.value = state.notes;

      updateLogoDisplay();
    }

    function updateLogoDisplay() {
      if (state.sellerLogo) {
        if (logoPreviewThumbWrap) logoPreviewThumbWrap.classList.remove('hidden');
        if (logoPreviewThumb) logoPreviewThumb.src = state.sellerLogo;
        if (docLogoWrap) docLogoWrap.classList.remove('hidden');
        if (docLogoImg) docLogoImg.src = state.sellerLogo;
      } else {
        if (logoPreviewThumbWrap) logoPreviewThumbWrap.classList.add('hidden');
        if (logoPreviewThumb) logoPreviewThumb.src = '';
        if (docLogoWrap) docLogoWrap.classList.add('hidden');
        if (docLogoImg) docLogoImg.src = '';
      }
    }

    // Render Line Items in Form Editor
    function renderEditorLineItems() {
      if (!lineItemsContainer) return;
      lineItemsContainer.innerHTML = '';

      state.items.forEach((item, index) => {
        const row = document.createElement('div');
        row.className = 'p-3.5 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] space-y-3';
        row.setAttribute('data-id', item.id);

        row.innerHTML = `
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-mono text-[var(--text-muted)]">#${index + 1}</span>
            ${
              state.items.length > 1
                ? `<button type="button" class="btn-remove-item p-1 text-[var(--text-muted)] hover:text-[var(--negative-text)] transition-colors cursor-pointer" data-id="${item.id}" title="Remove item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                  </button>`
                : ''
            }
          </div>
          <div class="space-y-1">
            <input
              type="text"
              class="item-desc-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
              placeholder="Item description"
              value="${item.description.replace(/"/g, '&quot;')}"
              data-id="${item.id}"
            />
          </div>
          <div class="grid grid-cols-4 gap-2 text-xs">
            <div>
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Qty</label>
              <input
                type="number"
                min="0"
                step="any"
                class="item-qty-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
                value="${item.quantity}"
                data-id="${item.id}"
              />
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Price</label>
              <input
                type="number"
                min="0"
                step="any"
                class="item-price-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
                value="${item.unitPrice}"
                data-id="${item.id}"
              />
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Disc %</label>
              <input
                type="number"
                min="0"
                max="100"
                step="any"
                class="item-disc-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
                value="${item.discountPercent}"
                data-id="${item.id}"
              />
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-muted)] uppercase mb-1">Tax %</label>
              <input
                type="number"
                min="0"
                max="100"
                step="any"
                class="item-tax-input w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2 py-1 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
                value="${item.taxPercent}"
                data-id="${item.id}"
              />
            </div>
          </div>
        `;

        lineItemsContainer.appendChild(row);
      });

      // Bind row listeners
      lineItemsContainer.querySelectorAll('.item-desc-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            it.description = target.value;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-qty-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            const parsed = parseFloat(target.value);
            it.quantity = isNaN(parsed) || parsed < 0 ? 0 : parsed;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-price-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            const parsed = parseFloat(target.value);
            it.unitPrice = isNaN(parsed) || parsed < 0 ? 0 : parsed;
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-disc-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            const parsed = parseFloat(target.value);
            it.discountPercent = isNaN(parsed) || parsed < 0 ? 0 : Math.min(100, parsed);
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.item-tax-input').forEach((el) => {
        el.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const it = state.items.find((x) => x.id === id);
          if (it) {
            const parsed = parseFloat(target.value);
            it.taxPercent = isNaN(parsed) || parsed < 0 ? 0 : Math.min(100, parsed);
            updatePreview();
            saveToStorage();
          }
        });
      });

      lineItemsContainer.querySelectorAll('.btn-remove-item').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (state.items.length > 1) {
            state.items = state.items.filter((x) => x.id !== target);
            renderEditorLineItems();
            updatePreview();
            saveToStorage();
          }
        });
      });
    }

    // Update Live Document Preview & Mathematical Totals
    function updatePreview() {
      // 1. Text Fields Sync
      if (docSellerName) docSellerName.textContent = state.sellerName || 'Your Business Name';
      if (docSellerAddress) docSellerAddress.textContent = state.sellerAddress || '';
      if (docSellerEmail) docSellerEmail.textContent = state.sellerEmail || '';
      if (docSellerPhone) docSellerPhone.textContent = state.sellerPhone || '';
      if (docSellerTaxId) {
        docSellerTaxId.textContent = state.sellerTaxId ? `Tax ID: ${state.sellerTaxId}` : '';
        docSellerTaxId.style.display = state.sellerTaxId ? 'block' : 'none';
      }

      if (docCustomerCompany) docCustomerCompany.textContent = state.customerCompany || 'Customer Name / Company';
      if (docCustomerName) {
        docCustomerName.textContent = state.customerName ? `Attn: ${state.customerName}` : '';
        docCustomerName.style.display = state.customerName ? 'block' : 'none';
      }
      if (docCustomerAddress) docCustomerAddress.textContent = state.customerAddress || '';
      if (docCustomerEmail) docCustomerEmail.textContent = state.customerEmail || '';
      if (docCustomerTaxId) {
        docCustomerTaxId.textContent = state.customerTaxId ? `Tax ID: ${state.customerTaxId}` : '';
        docCustomerTaxId.style.display = state.customerTaxId ? 'block' : 'none';
      }

      if (docInvoiceNumber) docInvoiceNumber.textContent = state.invoiceNumber || 'INV-001';
      if (docInvoiceDate) docInvoiceDate.textContent = state.invoiceDate || '';
      if (docInvoiceDueDate) docInvoiceDueDate.textContent = state.dueDate || '';
      if (docPaymentTerms) docPaymentTerms.textContent = state.paymentTerms || '';
      if (docPaymentTermsWrap) {
        docPaymentTermsWrap.style.display = state.paymentTerms ? 'flex' : 'none';
      }

      if (docNotesText) docNotesText.textContent = state.notes || '';

      // 2. Line Items Calculation and Table Render
      if (!docItemsTbody) return;
      docItemsTbody.innerHTML = '';

      let subtotalSum = 0;
      let discountSum = 0;
      let taxSum = 0;

      state.items.forEach((item) => {
        const qty = Number.isFinite(item.quantity) && item.quantity >= 0 ? item.quantity : 0;
        const price = Number.isFinite(item.unitPrice) && item.unitPrice >= 0 ? item.unitPrice : 0;
        const discPct = Number.isFinite(item.discountPercent) && item.discountPercent >= 0 ? item.discountPercent : 0;
        const taxPct = Number.isFinite(item.taxPercent) && item.taxPercent >= 0 ? item.taxPercent : 0;

        const rawLineSubtotal = qty * price;
        const lineDiscount = rawLineSubtotal * (discPct / 100);
        const lineNet = rawLineSubtotal - lineDiscount;
        const lineTax = lineNet * (taxPct / 100);
        const lineAmount = lineNet + lineTax;

        subtotalSum += rawLineSubtotal;
        discountSum += lineDiscount;
        taxSum += lineTax;

        const tr = document.createElement('tr');
        tr.className = 'text-neutral-800';
        tr.innerHTML = `
          <td class="py-3 pr-4 font-normal">${item.description || '—'}</td>
          <td class="py-3 px-2 text-right font-mono tabular-nums">${qty}</td>
          <td class="py-3 px-2 text-right font-mono tabular-nums">${formatMoney(price, state.currency)}</td>
          <td class="py-3 px-2 text-right font-mono tabular-nums text-neutral-500">${discPct > 0 ? `${discPct}%` : '—'}</td>
          <td class="py-3 px-2 text-right font-mono tabular-nums text-neutral-500">${taxPct > 0 ? `${taxPct}%` : '—'}</td>
          <td class="py-3 pl-4 text-right font-mono font-medium text-neutral-900 tabular-nums">${formatMoney(lineAmount, state.currency)}</td>
        `;
        docItemsTbody.appendChild(tr);
      });

      const finalTotal = Math.max(0, subtotalSum - discountSum + taxSum);

      if (docSubtotalVal) docSubtotalVal.textContent = formatMoney(subtotalSum, state.currency);

      if (docDiscountRow && docDiscountVal) {
        if (discountSum > 0) {
          docDiscountRow.classList.remove('hidden');
          docDiscountVal.textContent = `-${formatMoney(discountSum, state.currency)}`;
        } else {
          docDiscountRow.classList.add('hidden');
        }
      }

      if (docTaxRow && docTaxVal) {
        if (taxSum > 0) {
          docTaxRow.classList.remove('hidden');
          docTaxVal.textContent = formatMoney(taxSum, state.currency);
        } else {
          docTaxRow.classList.add('hidden');
        }
      }

      if (docTotalVal) docTotalVal.textContent = formatMoney(finalTotal, state.currency);
    }

    // Bind Top-Level Field Listeners
    sellerNameInput?.addEventListener('input', (e) => {
      state.sellerName = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    sellerAddressInput?.addEventListener('input', (e) => {
      state.sellerAddress = (e.target as HTMLTextAreaElement).value;
      updatePreview();
      saveToStorage();
    });
    sellerEmailInput?.addEventListener('input', (e) => {
      state.sellerEmail = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    sellerPhoneInput?.addEventListener('input', (e) => {
      state.sellerPhone = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    sellerTaxIdInput?.addEventListener('input', (e) => {
      state.sellerTaxId = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    sellerWebsiteInput?.addEventListener('input', (e) => {
      state.sellerWebsite = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });

    customerCompanyInput?.addEventListener('input', (e) => {
      state.customerCompany = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    customerNameInput?.addEventListener('input', (e) => {
      state.customerName = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    customerAddressInput?.addEventListener('input', (e) => {
      state.customerAddress = (e.target as HTMLTextAreaElement).value;
      updatePreview();
      saveToStorage();
    });
    customerEmailInput?.addEventListener('input', (e) => {
      state.customerEmail = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    customerTaxIdInput?.addEventListener('input', (e) => {
      state.customerTaxId = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });

    invoiceNumberInput?.addEventListener('input', (e) => {
      state.invoiceNumber = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    invoiceDateInput?.addEventListener('input', (e) => {
      state.invoiceDate = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    invoiceDueDateInput?.addEventListener('input', (e) => {
      state.dueDate = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    invoiceCurrencySelect?.addEventListener('change', (e) => {
      state.currency = (e.target as HTMLSelectElement).value;
      updatePreview();
      saveToStorage();
    });
    invoicePaymentTermsInput?.addEventListener('input', (e) => {
      state.paymentTerms = (e.target as HTMLInputElement).value;
      updatePreview();
      saveToStorage();
    });
    invoiceNotesInput?.addEventListener('input', (e) => {
      state.notes = (e.target as HTMLTextAreaElement).value;
      updatePreview();
      saveToStorage();
    });

    // Logo Upload Reader (Local DataURL)
    logoFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      // Validate size (< 2MB)
      if (file.size > 2 * 1024 * 1024) {
        alert('Please choose an image under 2MB.');
        return;
      }

      const reader = new FileReader();
      reader.onload = (loadEvt) => {
        const result = loadEvt.target?.result as string;
        if (result) {
          state.sellerLogo = result;
          updateLogoDisplay();
          saveToStorage();
        }
      };
      reader.readAsDataURL(file);
    });

    btnRemoveLogo?.addEventListener('click', () => {
      state.sellerLogo = '';
      if (logoFileInput) logoFileInput.value = '';
      updateLogoDisplay();
      saveToStorage();
    });

    // Add Item Handler
    btnAddLineItem?.addEventListener('click', () => {
      state.items.push({
        id: `item-${Date.now()}`,
        description: 'New Project Deliverable / Service',
        quantity: 1,
        unitPrice: 100,
        discountPercent: 0,
        taxPercent: 0,
      });
      renderEditorLineItems();
      updatePreview();
      saveToStorage();
    });

    // Clear / Reset Handler
    const btnClearDraft = document.getElementById('btn-clear-draft');
    btnClearDraft?.addEventListener('click', () => {
      const confirmPrompt = root.getAttribute('data-confirm-clear') || 'Are you sure you want to clear this draft? All entered invoice data will be reset.';
      if (confirm(confirmPrompt)) {
        try {
          localStorage.removeItem(STORAGE_KEY);
        } catch {}
        state = {
          ...defaultState,
          items: [
            {
              id: 'item-1',
              description: 'Professional Services',
              quantity: 1,
              unitPrice: 500,
              discountPercent: 0,
              taxPercent: 0,
            },
          ],
        };
        populateFormFields();
        renderEditorLineItems();
        updatePreview();
      }
    });

    // Print & Save Actions
    const btnPrint = document.getElementById('btn-print-invoice');
    const btnSavePdf = document.getElementById('btn-save-pdf');

    btnPrint?.addEventListener('click', () => {
      window.print();
    });

    btnSavePdf?.addEventListener('click', () => {
      window.print();
    });

    // Mobile View Toggle Tabs
    const tabBtnEditor = document.getElementById('tab-btn-editor');
    const tabBtnPreview = document.getElementById('tab-btn-preview');
    const editorCol = document.getElementById('invoice-editor-col');
    const previewCol = document.getElementById('invoice-preview-col');

    function setMobileView(view: 'editor' | 'preview') {
      if (view === 'editor') {
        tabBtnEditor?.classList.add('bg-[var(--surface-elevated)]', 'text-[var(--text-primary)]', 'border');
        tabBtnEditor?.classList.remove('text-[var(--text-secondary)]');
        tabBtnPreview?.classList.remove('bg-[var(--surface-elevated)]', 'text-[var(--text-primary)]', 'border');
        tabBtnPreview?.classList.add('text-[var(--text-secondary)]');

        editorCol?.classList.remove('hidden');
        previewCol?.classList.add('hidden', 'lg:block');
      } else {
        tabBtnPreview?.classList.add('bg-[var(--surface-elevated)]', 'text-[var(--text-primary)]', 'border');
        tabBtnPreview?.classList.remove('text-[var(--text-secondary)]');
        tabBtnEditor?.classList.remove('bg-[var(--surface-elevated)]', 'text-[var(--text-primary)]', 'border');
        tabBtnEditor?.classList.add('text-[var(--text-secondary)]');

        editorCol?.classList.add('hidden');
        previewCol?.classList.remove('hidden');
      }
    }

    tabBtnEditor?.addEventListener('click', () => setMobileView('editor'));
    tabBtnPreview?.addEventListener('click', () => setMobileView('preview'));

    // Initialize display
    populateFormFields();
    renderEditorLineItems();
    updatePreview();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInvoiceGenerator);
  } else {
    initInvoiceGenerator();
  }
  document.addEventListener('astro:page-load', initInvoiceGenerator);
</script>
