---
import {
  Printer,
  Download,
  RotateCcw,
  Plus,
  Upload,
  Sparkles,
  Building2,
  User,
  FileText,
  ShieldCheck,
  CreditCard,
  PenTool,
  Palette,
  Sliders,
  Table,
} from 'lucide-astro';
import type { SupportedLocale } from '../../lib/i18n/types';
import { getInvoiceTranslations, SUPPORTED_CURRENCIES } from '../../lib/i18n/invoice';
import type { DocumentType } from '../../lib/i18n/invoice/types';

export interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
const t = getInvoiceTranslations(locale);

const todayStr = new Date().toISOString().split('T')[0];
const defaultDueDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

const docTypeOptions: Array<{ value: DocumentType; label: string }> = [
  { value: 'invoice', label: t.docTypes.invoice },
  { value: 'quotation', label: t.docTypes.quotation },
  { value: 'proforma', label: t.docTypes.proforma },
  { value: 'estimate', label: t.docTypes.estimate },
  { value: 'purchase_order', label: t.docTypes.purchase_order },
  { value: 'receipt', label: t.docTypes.receipt },
  { value: 'credit_note', label: t.docTypes.credit_note },
  { value: 'debit_note', label: t.docTypes.debit_note },
  { value: 'delivery_challan', label: t.docTypes.delivery_challan },
  { value: 'custom', label: t.docTypes.custom },
];
---

<div id="invoice-generator-root" class="w-full" data-locale={locale} data-confirm-clear={t.actions.confirmClear}>
  <!-- Mobile Mode Switch Tabs (Editor / Live Preview) -->
  <div class="lg:hidden flex items-center justify-center p-1 bg-[var(--surface-subtle)] border border-[var(--border)] rounded-lg mb-6 no-print">
    <button
      type="button"
      id="tab-btn-editor"
      class="flex-1 py-2 px-4 text-xs font-medium rounded-md bg-[var(--surface-elevated)] text-[var(--text-primary)] border border-[var(--border)] shadow-xs transition-colors cursor-pointer"
    >
      {t.actions.editMode}
    </button>
    <button
      type="button"
      id="tab-btn-preview"
      class="flex-1 py-2 px-4 text-xs font-medium rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
    >
      {t.actions.previewMode}
    </button>
  </div>

  <!-- Primary Workspace Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
    <!-- LEFT COLUMN: Progressive Form Editor -->
    <div id="invoice-editor-col" class="lg:block lg:col-span-6 space-y-6 no-print">
      <!-- Action Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-xl border border-[var(--border)] bg-[var(--surface)]">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-print-invoice"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium rounded-lg bg-[var(--text-primary)] text-[var(--background)] hover:opacity-90 transition-opacity cursor-pointer focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
          >
            <Printer class="w-3.5 h-3.5" />
            <span>{t.actions.printInvoice}</span>
          </button>
          <button
            type="button"
            id="btn-save-pdf"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
            title={t.actions.savePdf}
          >
            <Download class="w-3.5 h-3.5" />
            <span>{t.actions.savePdf}</span>
          </button>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-load-sample"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] bg-[var(--surface-elevated)] border border-[var(--border)] rounded-md hover:border-[var(--border-focus)] transition-colors cursor-pointer"
            title={t.actions.loadSample}
          >
            <Sparkles class="w-3.5 h-3.5 text-amber-500" />
            <span>{t.actions.loadSample}</span>
          </button>
          <button
            type="button"
            id="btn-clear-draft"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs text-[var(--text-muted)] hover:text-[var(--negative-text)] hover:bg-[var(--surface-elevated)] rounded-md transition-colors cursor-pointer"
            title={t.actions.clearDraft}
          >
            <RotateCcw class="w-3 h-3" />
            <span>{t.actions.clearDraft}</span>
          </button>
        </div>
      </div>

      <!-- Document Designer / Customizer -->
      <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4 sm:p-5 space-y-4">
        <div class="flex items-center justify-between pb-2.5 border-b border-[var(--border)]">
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)] flex items-center gap-2">
            <Palette class="w-3.5 h-3.5" />
            <span>{t.customizer.title}</span>
          </h2>
          <span class="text-[11px] text-[var(--text-muted)]">{t.customizer.subtitle}</span>
        </div>

        <!-- Layout Style & Page Density Controls -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Layout Style Picker -->
          <div class="space-y-1.5">
            <label class="block text-xs font-medium text-[var(--text-secondary)]">
              {t.customizer.layoutLabel}
            </label>
            <div class="grid grid-cols-4 gap-1" id="layout-picker-btns">
              <button
                type="button"
                data-layout="classic"
                class="btn-layout-choice px-2 py-1.5 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer text-center"
              >
                {t.customizer.layouts.classic}
              </button>
              <button
                type="button"
                data-layout="modern"
                class="btn-layout-choice px-2 py-1.5 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer text-center"
              >
                {t.customizer.layouts.modern}
              </button>
              <button
                type="button"
                data-layout="minimal"
                class="btn-layout-choice px-2 py-1.5 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer text-center"
              >
                {t.customizer.layouts.minimal}
              </button>
              <button
                type="button"
                data-layout="compact"
                class="btn-layout-choice px-2 py-1.5 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer text-center"
              >
                {t.customizer.layouts.compact}
              </button>
            </div>
          </div>

          <!-- Density Picker -->
          <div class="space-y-1.5">
            <label class="block text-xs font-medium text-[var(--text-secondary)]">
              {t.customizer.densityLabel}
            </label>
            <div class="grid grid-cols-2 gap-1.5" id="density-picker-btns">
              <button
                type="button"
                data-density="comfortable"
                class="btn-density-choice px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer text-center"
              >
                {t.customizer.densities.comfortable}
              </button>
              <button
                type="button"
                data-density="compact"
                class="btn-density-choice px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer text-center"
              >
                {t.customizer.densities.compact}
              </button>
            </div>
          </div>
        </div>

        <!-- Customize Table & Sections Accordion / Toggle Panels -->
        <div class="pt-2 border-t border-[var(--border)] space-y-3">
          <!-- Table Columns Customization -->
          <details class="group rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] overflow-hidden">
            <summary class="flex items-center justify-between p-3 text-xs font-medium text-[var(--text-primary)] cursor-pointer select-none">
              <span class="flex items-center gap-2">
                <Table class="w-3.5 h-3.5 text-[var(--text-muted)]" />
                <span>{t.customizer.customizeTable}</span>
              </span>
              <span class="text-[11px] text-[var(--text-muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="p-3 pt-0 border-t border-[var(--border)] mt-2 grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs">
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="col-toggle-index" class="rounded border-[var(--border)] text-[var(--text-primary)]" checked />
                <span>{t.customizer.columns.index}</span>
              </label>
              <label class="flex items-center gap-2 text-[var(--text-muted)] cursor-not-allowed">
                <input type="checkbox" id="col-toggle-item" class="rounded border-[var(--border)] text-[var(--text-primary)]" checked disabled />
                <span>{t.customizer.columns.item}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="col-toggle-hsn" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.columns.hsn}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="col-toggle-unit" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.columns.unit}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="col-toggle-qty" class="rounded border-[var(--border)] text-[var(--text-primary)]" checked />
                <span>{t.customizer.columns.qty}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="col-toggle-rate" class="rounded border-[var(--border)] text-[var(--text-primary)]" checked />
                <span>{t.customizer.columns.rate}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="col-toggle-discount" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.columns.discount}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="col-toggle-tax" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.columns.tax}</span>
              </label>
              <label class="flex items-center gap-2 text-[var(--text-muted)] cursor-not-allowed">
                <input type="checkbox" id="col-toggle-amount" class="rounded border-[var(--border)] text-[var(--text-primary)]" checked disabled />
                <span>{t.customizer.columns.amount}</span>
              </label>
            </div>
          </details>

          <!-- Sections Customization -->
          <details class="group rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] overflow-hidden">
            <summary class="flex items-center justify-between p-3 text-xs font-medium text-[var(--text-primary)] cursor-pointer select-none">
              <span class="flex items-center gap-2">
                <Sliders class="w-3.5 h-3.5 text-[var(--text-muted)]" />
                <span>{t.customizer.customizeSections}</span>
              </span>
              <span class="text-[11px] text-[var(--text-muted)] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="p-3 pt-0 border-t border-[var(--border)] mt-2 grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs">
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="sec-toggle-shipping" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.sections.shipping}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="sec-toggle-references" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.sections.references}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="sec-toggle-payment" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.sections.payment}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="sec-toggle-notes" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.sections.notes}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="sec-toggle-terms" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.sections.terms}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="sec-toggle-declaration" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.sections.declaration}</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-[var(--text-secondary)]">
                <input type="checkbox" id="sec-toggle-signature" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.customizer.sections.signature}</span>
              </label>
            </div>
          </details>
        </div>
      </section>

      <!-- Progressive Form Sections -->
      <div class="space-y-5">
        <!-- 1. Document Setup -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border)]">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)] flex items-center gap-2">
              <FileText class="w-3.5 h-3.5" />
              <span>{t.sections.document}</span>
            </h2>
            <span class="text-[11px] text-[var(--text-muted)]">Step 1</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="doc-type-select" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.docType}
              </label>
              <select
                id="doc-type-select"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--text-primary)]"
              >
                {docTypeOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>

            <div class="space-y-1.5">
              <label for="invoice-currency" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.currency}
              </label>
              <select
                id="invoice-currency"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--text-primary)]"
              >
                {SUPPORTED_CURRENCIES.map((curr) => (
                  <option value={curr.code}>{curr.name}</option>
                ))}
              </select>
            </div>

            <div id="doc-custom-title-wrap" class="hidden sm:col-span-2 space-y-1.5">
              <label for="doc-custom-title-input" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.customTitle}
              </label>
              <input
                type="text"
                id="doc-custom-title-input"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="e.g. COMMERCIAL QUOTE / SERVICE RECEIPT"
              />
            </div>

            <div class="sm:col-span-2 space-y-1.5">
              <label for="doc-copy-label-select" class="block text-xs font-medium text-[var(--text-secondary)]">
                Document Copy Tag
              </label>
              <select
                id="doc-copy-label-select"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--text-primary)]"
              >
                <option value="">None (Standard Document)</option>
                <option value="Original for Recipient">Original for Recipient</option>
                <option value="Duplicate for Supplier">Duplicate for Supplier</option>
                <option value="Triplicate for Transporter">Triplicate for Transporter</option>
              </select>
            </div>
          </div>
        </section>

        <!-- 2. Seller / Business Information -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border)]">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)] flex items-center gap-2">
              <Building2 class="w-3.5 h-3.5" />
              <span>{t.sections.seller}</span>
            </h2>
            <span class="text-[11px] text-[var(--text-muted)]">Step 2</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2 space-y-1.5">
              <label for="seller-name" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.businessName}
              </label>
              <input
                type="text"
                id="seller-name"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="e.g. Northstar Studio / Acme Corp"
              />
            </div>

            <!-- Logo Upload -->
            <div class="sm:col-span-2 space-y-2">
              <label class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.businessLogo}
              </label>
              <div class="flex items-center gap-4">
                <div id="logo-preview-thumb-wrap" class="hidden relative w-12 h-12 rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] p-1 flex items-center justify-center overflow-hidden">
                  <img id="logo-preview-thumb" src="" alt="Logo" class="max-w-full max-h-full object-contain" />
                </div>
                <label class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer">
                  <Upload class="w-3.5 h-3.5" />
                  <span>{t.fields.uploadLogo}</span>
                  <input type="file" id="logo-file-input" accept="image/png, image/jpeg, image/svg+xml" class="sr-only" />
                </label>
                <button
                  type="button"
                  id="btn-remove-logo"
                  class="hidden text-xs text-[var(--text-muted)] hover:text-[var(--negative-text)] transition-colors cursor-pointer"
                >
                  {t.fields.removeLogo}
                </button>
              </div>
            </div>

            <div class="sm:col-span-2 space-y-1.5">
              <label for="seller-address" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.address}
              </label>
              <textarea
                id="seller-address"
                rows="2"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)] resize-none"
                placeholder="Street address, City, PIN/Postal Code"
              ></textarea>
            </div>

            <div class="space-y-1.5">
              <label for="seller-email" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.email}
              </label>
              <input
                type="email"
                id="seller-email"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="billing@yourbusiness.com"
              />
            </div>

            <div id="seller-phone-wrap" class="hidden space-y-1.5">
              <label for="seller-phone" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.phone}
              </label>
              <input
                type="text"
                id="seller-phone"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="+1 555 010 2847"
              />
            </div>

            <div id="seller-tax-wrap" class="hidden space-y-1.5">
              <label for="seller-tax-id" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.taxId}
              </label>
              <input
                type="text"
                id="seller-tax-id"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] font-mono placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="27AAAAA0000A1Z5"
              />
            </div>

            <div id="seller-pan-wrap" class="hidden space-y-1.5">
              <label for="seller-pan" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.pan}
              </label>
              <input
                type="text"
                id="seller-pan"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] font-mono placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="AAAAA0000A"
              />
            </div>

            <div id="seller-state-wrap" class="hidden sm:col-span-2 grid grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="seller-state" class="block text-xs font-medium text-[var(--text-secondary)]">
                  {t.fields.state}
                </label>
                <input
                  type="text"
                  id="seller-state"
                  class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="e.g. Maharashtra"
                />
              </div>
              <div class="space-y-1.5">
                <label for="seller-state-code" class="block text-xs font-medium text-[var(--text-secondary)]">
                  {t.fields.stateCode}
