        <!-- ADAPTIVE LOWER DOCUMENT SECTIONS -->
        <div id="doc-adaptive-closing-sections" class="space-y-2.5 pt-2">
          <!-- ROW 1: Financial Totals & Amount In Words -->
          <div id="doc-financial-row" class="pt-3 border-t-2 border-neutral-300 flex flex-col sm:flex-row justify-between items-start gap-4">
            <!-- Left: Amount in Words -->
