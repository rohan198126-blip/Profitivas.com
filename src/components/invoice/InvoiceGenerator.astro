---
import { Printer, Download, RotateCcw, Plus, Upload, CheckCircle2 } from 'lucide-astro';
import type { SupportedLocale } from '../../lib/i18n/types';
import { getInvoiceTranslations, SUPPORTED_CURRENCIES } from '../../lib/i18n/invoice';

export interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
const t = getInvoiceTranslations(locale);

const todayStr = new Date().toISOString().split('T')[0];
const defaultDueDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
---

<div id="invoice-generator-root" class="w-full" data-locale={locale} data-confirm-clear={t.actions.confirmClear}>
  <!-- Mobile Mode Switch Tabs (Editor / Live Preview) -->
  <div class="lg:hidden flex items-center justify-center p-1 bg-[var(--surface-subtle)] border border-[var(--border)] rounded-lg mb-6 no-print">
    <button
      type="button"
      id="tab-btn-editor"
      class="flex-1 py-2 px-4 text-xs font-medium rounded-md bg-[var(--surface-elevated)] text-[var(--text-primary)] border border-[var(--border)] shadow-xs transition-colors cursor-pointer"
    >
      {t.actions.editMode}
    </button>
    <button
      type="button"
      id="tab-btn-preview"
      class="flex-1 py-2 px-4 text-xs font-medium rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
    >
      {t.actions.previewMode}
    </button>
  </div>

  <!-- Primary Workspace Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
    <!-- LEFT COLUMN: Editor Controls -->
    <div id="invoice-editor-col" class="lg:col-span-6 space-y-6 no-print">
      <!-- Action Toolbar (Top Quick Actions) -->
      <div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-xl border border-[var(--border)] bg-[var(--surface)]">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-print-invoice"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium rounded-lg bg-[var(--text-primary)] text-[var(--background)] hover:opacity-90 transition-opacity cursor-pointer focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
          >
            <Printer class="w-3.5 h-3.5" />
            <span>{t.actions.printInvoice}</span>
          </button>
          <button
            type="button"
            id="btn-save-pdf"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
            title="Save invoice using your browser's PDF print option"
          >
            <Download class="w-3.5 h-3.5" />
            <span>{t.actions.savePdf}</span>
          </button>
        </div>

        <button
          type="button"
          id="btn-clear-draft"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs text-[var(--text-muted)] hover:text-[var(--negative-text)] hover:bg-[var(--surface-elevated)] rounded-md transition-colors cursor-pointer"
          title={t.actions.clearDraft}
        >
          <RotateCcw class="w-3 h-3" />
          <span>{t.actions.clearDraft}</span>
        </button>
      </div>

      <!-- Progressive Form Sections Accordion / Cards -->
      <div class="space-y-5">
        <!-- 1. Seller Information -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border)]">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">
              {t.sections.seller}
            </h2>
            <span class="text-[11px] text-[var(--text-muted)]">Step 1</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2 space-y-1.5">
              <label for="seller-name" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.businessName} *
              </label>
              <input
                type="text"
                id="seller-name"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="Acme Studio Inc."
                value="Acme Studio Inc."
              />
            </div>

            <!-- Logo Upload -->
            <div class="sm:col-span-2 space-y-2">
              <label class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.businessLogo}
              </label>
              <div class="flex items-center gap-3">
                <label
                  for="logo-file-input"
                  class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
                >
                  <Upload class="w-3.5 h-3.5" />
                  <span>{t.fields.uploadLogo}</span>
                  <input
                    type="file"
                    id="logo-file-input"
                    accept="image/png, image/jpeg, image/webp, image/svg+xml"
                    class="sr-only"
                  />
                </label>
                <div id="logo-preview-thumb-wrap" class="hidden flex items-center gap-2">
                  <img id="logo-preview-thumb" src="" alt="Logo thumbnail" class="h-7 w-auto max-w-[80px] object-contain rounded border border-[var(--border)] p-0.5 bg-white" />
                  <button type="button" id="btn-remove-logo" class="text-xs text-[var(--text-muted)] hover:text-[var(--negative-text)] transition-colors cursor-pointer">
                    {t.fields.removeLogo}
                  </button>
                </div>
              </div>
            </div>

            <div class="sm:col-span-2 space-y-1.5">
              <label for="seller-address" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.address}
              </label>
              <textarea
                id="seller-address"
                rows="2"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="100 Market St, Suite 400&#10;San Francisco, CA 94105"
              >100 Market St, Suite 400
San Francisco, CA 94105</textarea>
            </div>

            <div class="space-y-1.5">
              <label for="seller-email" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.email}
              </label>
              <input
                type="email"
                id="seller-email"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="billing@acmestudio.com"
                value="billing@acmestudio.com"
              />
            </div>

            <div class="space-y-1.5">
              <label for="seller-phone" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.phone}
              </label>
              <input
                type="text"
                id="seller-phone"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="+1 (555) 019-2834"
                value="+1 (555) 019-2834"
              />
            </div>

            <div class="space-y-1.5">
              <label for="seller-tax-id" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.taxId}
              </label>
              <input
                type="text"
                id="seller-tax-id"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="US-EIN 12-3456789"
                value="US-EIN 12-3456789"
              />
            </div>

            <div class="space-y-1.5">
              <label for="seller-website" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.website}
              </label>
              <input
                type="text"
                id="seller-website"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="https://acmestudio.com"
                value="https://acmestudio.com"
              />
            </div>
          </div>
        </section>

        <!-- 2. Customer Information -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border)]">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">
              {t.sections.customer}
            </h2>
            <span class="text-[11px] text-[var(--text-muted)]">Step 2</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="customer-company" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.companyName}
              </label>
              <input
                type="text"
                id="customer-company"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="Venture Brands LLC"
                value="Venture Brands LLC"
              />
            </div>

            <div class="space-y-1.5">
              <label for="customer-name" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.clientName}
              </label>
              <input
                type="text"
                id="customer-name"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="Sarah Jenkins"
                value="Sarah Jenkins"
              />
            </div>

            <div class="sm:col-span-2 space-y-1.5">
              <label for="customer-address" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.address}
              </label>
              <textarea
                id="customer-address"
                rows="2"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="450 Broadway Ave, Floor 8&#10;New York, NY 10013"
              >450 Broadway Ave, Floor 8
New York, NY 10013</textarea>
            </div>

            <div class="space-y-1.5">
              <label for="customer-email" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.email}
              </label>
              <input
                type="email"
                id="customer-email"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="accounting@venturebrands.com"
                value="accounting@venturebrands.com"
              />
            </div>

            <div class="space-y-1.5">
              <label for="customer-tax-id" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.taxId}
              </label>
              <input
                type="text"
                id="customer-tax-id"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="Tax ID (optional)"
              />
            </div>
          </div>
        </section>

        <!-- 3. Invoice Meta & Currency -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border)]">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">
              {t.sections.invoiceDetails}
            </h2>
            <span class="text-[11px] text-[var(--text-muted)]">Step 3</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="space-y-1.5">
              <label for="invoice-number" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.invoiceNumber} *
              </label>
              <input
                type="text"
                id="invoice-number"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm font-mono text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="INV-2026-001"
                value="INV-2026-001"
              />
            </div>

            <div class="space-y-1.5">
              <label for="invoice-date" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.invoiceDate} *
              </label>
              <input
                type="date"
                id="invoice-date"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--text-primary)]"
                value={todayStr}
              />
            </div>

            <div class="space-y-1.5">
              <label for="invoice-due-date" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.dueDate}
              </label>
              <input
                type="date"
                id="invoice-due-date"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--text-primary)]"
                value={defaultDueDate}
              />
            </div>

            <div class="space-y-1.5">
              <label for="invoice-currency" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.currency}
              </label>
              <select
                id="invoice-currency"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--text-primary)] cursor-pointer"
              >
                {SUPPORTED_CURRENCIES.map((curr) => (
                  <option value={curr.code} selected={curr.code === 'USD'}>
                    {curr.name}
                  </option>
                ))}
              </select>
            </div>

            <div class="sm:col-span-2 space-y-1.5">
              <label for="invoice-payment-terms" class="block text-xs font-medium text-[var(--text-secondary)]">
                {t.fields.paymentTerms}
              </label>
              <input
                type="text"
                id="invoice-payment-terms"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                placeholder="Net 30 / Due on Receipt"
                value="Net 30"
              />
            </div>
          </div>
        </section>

        <!-- 4. Line Items -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border)]">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">
              {t.sections.items}
            </h2>
            <span class="text-[11px] text-[var(--text-muted)]">Step 4</span>
          </div>

          <!-- Dynamic Line Items Container -->
          <div id="line-items-container" class="space-y-3.5">
            <!-- Rendered via JS -->
          </div>

          <!-- Add Line Item Button -->
          <div class="pt-2">
            <button
              type="button"
              id="btn-add-line-item"
              class="w-full py-2.5 px-4 text-xs font-medium rounded-lg border border-dashed border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] hover:bg-[var(--surface-elevated)] transition-colors cursor-pointer flex items-center justify-center gap-1.5"
            >
              <Plus class="w-3.5 h-3.5" />
              <span>{t.fields.addItem}</span>
            </button>
          </div>
        </section>

        <!-- 5. Notes & Terms -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-3">
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)] pb-2 border-b border-[var(--border)]">
            {t.sections.notes}
          </h2>
          <textarea
            id="invoice-notes"
            rows="3"
            class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
            placeholder={t.fields.notesPlaceholder}
          >Payment is due within 30 days of invoice date. Please transfer to Wire/ACH: Bank of America, Routing #123456789, Account #987654321. Thank you for your business!</textarea>
        </section>

        <!-- Privacy & Local Security Notice -->
        <div class="p-4 rounded-lg bg-[var(--surface-subtle)] border border-[var(--border)] text-xs text-[var(--text-muted)] leading-relaxed flex items-start gap-2.5">
          <CheckCircle2 class="w-4 h-4 text-[var(--positive-text)] shrink-0 mt-0.5" />
          <span>{t.privacyNotice}</span>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Professional Paper Live Preview -->
    <div id="invoice-preview-col" class="lg:col-span-6 lg:sticky lg:top-24">
      <!-- Printable Sheet Container (Styled like standard document paper) -->
      <div
        id="invoice-paper-sheet"
        class="bg-white text-neutral-900 rounded-lg shadow-xl border border-neutral-300 p-8 sm:p-10 font-sans text-xs sm:text-sm leading-normal max-w-full overflow-hidden"
      >
        <!-- Document Header: Seller Info + Invoice Title/Meta -->
        <div class="flex flex-col sm:flex-row justify-between gap-6 pb-8 border-b border-neutral-200">
          <!-- Left: Brand / Seller -->
          <div class="space-y-2 max-w-[280px]">
            <div id="doc-logo-wrap" class="hidden pb-1">
              <img id="doc-logo-img" src="" alt="Business Logo" class="max-h-12 max-w-[160px] object-contain" />
            </div>
            <h3 id="doc-seller-name" class="text-lg sm:text-xl font-bold tracking-tight text-neutral-900 leading-tight">
              Acme Studio Inc.
            </h3>
            <p id="doc-seller-address" class="text-xs text-neutral-600 whitespace-pre-line leading-relaxed">
              100 Market St, Suite 400
              San Francisco, CA 94105
            </p>
            <div id="doc-seller-contact" class="text-xs text-neutral-600 space-y-0.5 pt-0.5">
              <div id="doc-seller-email">billing@acmestudio.com</div>
              <div id="doc-seller-phone">+1 (555) 019-2834</div>
              <div id="doc-seller-tax-id" class="font-mono text-[11px] pt-1">Tax ID: US-EIN 12-3456789</div>
            </div>
          </div>

          <!-- Right: Document Name & Meta Box -->
          <div class="sm:text-right space-y-2 min-w-[180px]">
            <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-neutral-900 uppercase">
              {t.document.invoiceTitle}
            </h2>
            <div class="space-y-1 text-xs pt-1">
              <div class="flex sm:justify-end gap-2">
                <span class="text-neutral-500">{t.document.invoiceNumberLabel}:</span>
                <span id="doc-invoice-number" class="font-mono font-bold text-neutral-900">INV-2026-001</span>
              </div>
              <div class="flex sm:justify-end gap-2">
                <span class="text-neutral-500">{t.document.dateLabel}:</span>
                <span id="doc-invoice-date" class="font-medium text-neutral-900">{todayStr}</span>
              </div>
              <div class="flex sm:justify-end gap-2">
                <span class="text-neutral-500">{t.document.dueDateLabel}:</span>
                <span id="doc-invoice-due-date" class="font-medium text-neutral-900">{defaultDueDate}</span>
              </div>
              <div id="doc-payment-terms-wrap" class="flex sm:justify-end gap-2">
                <span class="text-neutral-500">{t.document.paymentTermsLabel}:</span>
                <span id="doc-payment-terms" class="font-medium text-neutral-900">Net 30</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Bill To Section -->
        <div class="py-6 border-b border-neutral-200">
          <span class="text-[10px] font-bold uppercase tracking-widest text-neutral-400 block mb-1.5">
            {t.document.billToLabel}
          </span>
          <div id="doc-customer-company" class="text-base font-bold text-neutral-900">
            Venture Brands LLC
          </div>
          <div id="doc-customer-name" class="text-xs text-neutral-700 font-medium mt-0.5">
            Attn: Sarah Jenkins
          </div>
          <div id="doc-customer-address" class="text-xs text-neutral-600 whitespace-pre-line mt-1 leading-relaxed">
            450 Broadway Ave, Floor 8
            New York, NY 10013
          </div>
          <div id="doc-customer-contact" class="text-xs text-neutral-600 mt-1 space-y-0.5">
            <div id="doc-customer-email">accounting@venturebrands.com</div>
            <div id="doc-customer-tax-id" class="font-mono text-[11px]"></div>
          </div>
        </div>

        <!-- Items Table -->
        <div class="py-6 overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b-2 border-neutral-300 text-[11px] uppercase font-bold text-neutral-600 tracking-wider">
                <th class="py-2 pr-4">{t.document.descHeader}</th>
                <th class="py-2 px-2 text-right w-16">{t.document.qtyHeader}</th>
                <th class="py-2 px-2 text-right w-24">{t.document.priceHeader}</th>
                <th class="py-2 px-2 text-right w-20">{t.document.discountHeader}</th>
                <th class="py-2 px-2 text-right w-16">{t.document.taxHeader}</th>
                <th class="py-2 pl-4 text-right w-24">{t.document.amountHeader}</th>
              </tr>
            </thead>
            <tbody id="doc-items-tbody" class="divide-y divide-neutral-200 text-xs sm:text-sm">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>

        <!-- Totals & Calculations Block -->
        <div class="pt-4 border-t-2 border-neutral-200 flex flex-col sm:flex-row justify-between items-start gap-6">
          <!-- Notes & Terms on Paper -->
          <div class="flex-1 space-y-2 text-xs text-neutral-600 max-w-sm">
            <span class="text-[10px] font-bold uppercase tracking-widest text-neutral-400 block">
              {t.document.notesLabel}
            </span>
            <p id="doc-notes-text" class="whitespace-pre-line leading-relaxed">
              Payment is due within 30 days of invoice date. Please transfer to Wire/ACH: Bank of America, Routing #123456789, Account #987654321. Thank you for your business!
            </p>
          </div>

          <!-- Numerical Breakdown -->
          <div class="w-full sm:w-64 space-y-2 text-xs">
            <div class="flex justify-between py-1 text-neutral-600">
              <span>{t.document.subtotalLabel}</span>
              <span id="doc-subtotal-val" class="font-mono font-medium text-neutral-900">$0.00</span>
            </div>
            <div id="doc-discount-row" class="hidden flex justify-between py-1 text-neutral-600">
              <span>{t.document.discountTotalLabel}</span>
              <span id="doc-discount-val" class="font-mono font-medium text-neutral-900">-$0.00</span>
            </div>
            <div id="doc-tax-row" class="hidden flex justify-between py-1 text-neutral-600">
              <span>{t.document.taxTotalLabel}</span>
              <span id="doc-tax-val" class="font-mono font-medium text-neutral-900">$0.00</span>
            </div>
            <div class="flex justify-between py-2 border-t-2 border-neutral-900 text-sm sm:text-base font-bold text-neutral-900">
              <span>{t.document.totalLabel}</span>
              <span id="doc-total-val" class="font-mono">$0.00</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

