      renderEditorLineItems();
      updatePreview();
      saveToStorage();
    });

    // Load Sample Data Handler (100% Fictional Data)
    const btnLoadSample = document.getElementById('btn-load-sample');
    btnLoadSample?.addEventListener('click', () => {
      isSampleActive = true;

      state = {
        version: 2,
        documentType: 'invoice',
        layout: 'modern',
        density: 'comfortable',
        tableColumns: {
          index: true,
          item: true,
          hsn: false,
          unit: true,
          qty: true,
          rate: true,
          discount: true,
          tax: false,
          amount: true,
        },
        sectionsConfig: {
          shipping: false,
          references: true,
          payment: true,
          notes: true,
          terms: true,
          declaration: true,
          signature: true,
        },
        customTitle: '',
        documentNumber: 'INV-2026-001',
        documentDate: new Date().toISOString().split('T')[0],
        dueDate: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
        validUntil: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
        currency: 'USD',
        copyLabel: 'Original for Recipient',
        placeOfSupply: '',
        placeOfSupplyCode: '',

        // Supplier (Northstar Creative Studio - 100% Fictional Example)
        sellerName: 'Northstar Creative Studio',
        sellerLogo: '',
        sellerAddress: '120 Market Street\nAustin, Texas 78701\nUnited States',
        sellerEmail: 'hello@northstar-example.com',
        sellerPhone: '+1 555 010 2847',
        sellerTaxId: '',
        sellerPan: '',
        sellerState: 'Texas',
        sellerStateCode: 'TX',
        sellerWebsite: 'https://northstar-example.com',

        // Customer (Harborline Retail Co. - 100% Fictional Example)
        customerCompany: 'Harborline Retail Co.',
        customerName: 'Morgan Davis',
        customerAddress: '48 Commerce Avenue\nDenver, Colorado 80202\nUnited States',
        customerEmail: 'accounts@harborline-example.com',
        customerPhone: '+1 555 010 6392',
        customerTaxId: '',
        customerPan: '',
        customerState: 'Colorado',
        customerStateCode: 'CO',

        // Shipping
        shippingEnabled: false,
        shippingSameAsCustomer: false,
        shippingName: '',
        shippingAddress: '',
        shippingTaxId: '',
        shippingDestination: '',

        // References
        refOrderNumber: 'PO-2026-881',
        refOrderDate: new Date().toISOString().split('T')[0],
        refQuoteNumber: '',
        refQuoteDate: '',
        refDeliveryNote: '',

        // Tax
        taxMode: 'none',
        gstSupplyType: 'cgst_sgst',
        reverseCharge: false,
        enableRoundOff: false,

        // Banking
        bankDetailsEnabled: true,
        bankName: 'First Example Bank',
        bankAccountName: 'Northstar Creative Studio',
        bankAccountNumber: '000123456789',
        bankIfsc: 'EXAMP01',
        bankBranch: 'Austin Central Branch',
        bankUpiId: '',
        paymentMethod: 'Direct Deposit / ACH / Wire',
        paymentTerms: 'Net 30 Days',

        // Legal
        notes: 'Thank you for your business. Please reach out to hello@northstar-example.com for any billing inquiries.',
        termsAndConditions: '1. Payment is due within 30 days of invoice date.\n2. Overdue balances are subject to a 1.5% monthly finance charge.\n3. All project deliverables remain intellectual property until full settlement.',
        declaration: 'We declare that this invoice shows the actual price of the services described and that all particulars are true and correct.',
        jurisdiction: 'Subject to Austin, Texas Jurisdiction',
        signatoryEnabled: true,
        signatoryName: 'Alex Morgan',
        signatoryDesignation: 'Managing Director',
        signatoryImage: '',

        items: [
          {
            id: 'sample-1',
            description: 'Brand Identity Design & Design System Guidelines',
            hsnSac: '',
            quantity: 1,
            unit: 'project',
            unitPrice: 2800,
            discountPercent: 0,
            taxPercent: 0,
          },
          {
            id: 'sample-2',
            description: 'E-Commerce Website Development (UI/UX Architecture & Responsive Setup)',
            hsnSac: '',
            quantity: 1,
            unit: 'project',
            unitPrice: 4200,
            discountPercent: 5,
            taxPercent: 0,
          },
        ],
      };

      populateFormFields();
      renderEditorLineItems();
      updatePreview();
      saveToStorage();
    });

    // Clear Form Handler (Clean Blank State)
    const btnClearDraft = document.getElementById('btn-clear-draft');
    btnClearDraft?.addEventListener('click', () => {
      const confirmPrompt =
        root.getAttribute('data-confirm-clear') ||
        'Are you sure you want to clear this draft? All entered document data will be reset.';
      if (confirm(confirmPrompt)) {
        try {
          localStorage.removeItem(STORAGE_KEY);
          localStorage.removeItem(LEGACY_STORAGE_KEY);
        } catch {}

        isSampleActive = false;
        if (docSampleBadge) docSampleBadge.classList.add('hidden');
        state = createBlankState();
        populateFormFields();
        renderEditorLineItems();
        updatePreview();
        saveToStorage();
      }
    });

    // Print & PDF Actions
    const btnPrint = document.getElementById('btn-print-invoice');
    const btnSavePdf = document.getElementById('btn-save-pdf');

    btnPrint?.addEventListener('click', () => window.print());
    btnSavePdf?.addEventListener('click', () => window.print());

    // Mobile View Toggle Tabs
    const tabBtnEditor = document.getElementById('tab-btn-editor');
    const tabBtnPreview = document.getElementById('tab-btn-preview');
    const editorCol = document.getElementById('invoice-editor-col');
    const previewCol = document.getElementById('invoice-preview-col');

    function setMobileView(mode: 'editor' | 'preview') {
      if (mode === 'editor') {
        tabBtnEditor?.classList.add('bg-[var(--surface-elevated)]', 'text-[var(--text-primary)]', 'border');
        tabBtnEditor?.classList.remove('text-[var(--text-secondary)]');
        tabBtnPreview?.classList.remove('bg-[var(--surface-elevated)]', 'text-[var(--text-primary)]', 'border');
        tabBtnPreview?.classList.add('text-[var(--text-secondary)]');

        editorCol?.classList.remove('hidden');
        previewCol?.classList.add('hidden');
      } else {
        tabBtnPreview?.classList.add('bg-[var(--surface-elevated)]', 'text-[var(--text-primary)]', 'border');
        tabBtnPreview?.classList.remove('text-[var(--text-secondary)]');
        tabBtnEditor?.classList.remove('bg-[var(--surface-elevated)]', 'text-[var(--text-primary)]', 'border');
        tabBtnEditor?.classList.add('text-[var(--text-secondary)]');

        editorCol?.classList.add('hidden');
        previewCol?.classList.remove('hidden');
      }
    }

    tabBtnEditor?.addEventListener('click', () => setMobileView('editor'));
    tabBtnPreview?.addEventListener('click', () => setMobileView('preview'));

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        editorCol?.classList.remove('hidden');
        previewCol?.classList.remove('hidden');
      }
    });

    // Initialize display
    populateFormFields();
    renderEditorLineItems();
    updatePreview();

    if (window.innerWidth < 1024) {
      setMobileView('editor');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBusinessDocumentGenerator);
  } else {
    initBusinessDocumentGenerator();
  }
  document.addEventListener('astro:page-load', initBusinessDocumentGenerator);
</script>
