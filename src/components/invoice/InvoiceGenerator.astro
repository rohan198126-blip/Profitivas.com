      }

      const hasSig = Boolean(
        state.sectionsConfig?.signature !== false &&
        (state.signatoryEnabled || state.signatoryName?.trim() || state.signatoryDesignation?.trim())
      );
      if (docSignatoryBox) {
        if (hasSig) {
