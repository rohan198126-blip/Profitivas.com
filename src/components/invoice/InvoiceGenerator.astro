            </label>

            <label class="p-3 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] flex items-center gap-2.5 cursor-pointer">
              <input type="radio" name="tax-mode" value="custom" class="text-[var(--text-primary)] focus:ring-[var(--focus-ring)]" />
              <div>
                <span class="font-medium text-[var(--text-primary)] block">{t.fields.customTax}</span>
                <span class="text-[11px] text-[var(--text-muted)]">Standard flat VAT/Sales Tax</span>
              </div>
            </label>

            <label class="p-3 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] flex items-center gap-2.5 cursor-pointer">
              <input type="radio" name="tax-mode" value="gst" class="text-[var(--text-primary)] focus:ring-[var(--focus-ring)]" />
              <div>
                <span class="font-medium text-[var(--text-primary)] block">{t.fields.indianGst}</span>
                <span class="text-[11px] text-[var(--text-muted)]">CGST + SGST or IGST</span>
              </div>
            </label>
          </div>

          <!-- Custom Tax Controls -->
          <div id="custom-tax-panel" class="hidden p-3.5 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] space-y-2">
            <label for="custom-tax-rate" class="block text-xs font-medium text-[var(--text-secondary)]">
              Default Tax Rate (%)
            </label>
            <input
              type="number"
              min="0"
              max="100"
              step="any"
              id="custom-tax-rate"
              class="w-36 rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] font-mono tabular-nums focus:outline-none focus:border-[var(--text-primary)]"
              value="18"
            />
          </div>

          <!-- Indian GST Controls -->
          <div id="indian-gst-panel" class="hidden p-4 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] space-y-3.5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="gst-rate-input" class="block text-xs font-medium text-[var(--text-secondary)]">
                  Applicable GST Rate (%)
                </label>
                <select
                  id="gst-rate-input"
                  class="w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] font-mono focus:outline-none focus:border-[var(--text-primary)]"
                >
                  <option value="18">18% (Standard Services / Goods)</option>
                  <option value="12">12%</option>
                  <option value="5">5%</option>
                  <option value="28">28% (Luxury / Automobiles)</option>
                  <option value="0">0% (Exempt)</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-medium text-[var(--text-secondary)]">
                  GST Supply Structure
                </label>
                <div class="flex items-center gap-3 pt-1 text-xs">
                  <label class="flex items-center gap-1.5 cursor-pointer">
                    <input type="radio" name="gst-supply-type" value="cgst_sgst" checked class="text-[var(--text-primary)]" />
                    <span>Intra-State (CGST + SGST)</span>
                  </label>
                  <label class="flex items-center gap-1.5 cursor-pointer">
                    <input type="radio" name="gst-supply-type" value="igst" class="text-[var(--text-primary)]" />
                    <span>Inter-State (IGST)</span>
                  </label>
                </div>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-1 text-xs text-[var(--text-secondary)]">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="gst-reverse-charge" class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.fields.reverseCharge}</span>
              </label>

              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="gst-round-off" checked class="rounded border-[var(--border)] text-[var(--text-primary)]" />
                <span>{t.fields.roundOff}</span>
              </label>
            </div>

            <p class="text-[11px] text-[var(--text-muted)] leading-relaxed pt-1 border-t border-[var(--border)]">
              Profitivas generates professional business documents for commercial and billing use. It does not file returns or connect directly to the GSTN portal.
            </p>
          </div>
        </section>

        <!-- 7. Bank & UPI Details -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border)]">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)] flex items-center gap-2">
              <CreditCard class="w-3.5 h-3.5" />
              <span>{t.sections.banking}</span>
            </h2>
            <span class="text-[11px] text-[var(--text-muted)]">Step 7</span>
          </div>

          <div id="banking-fields-wrap" class="hidden space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="bank-name" class="block text-xs font-medium text-[var(--text-secondary)]">
                  {t.fields.bankName}
                </label>
                <input
                  type="text"
                  id="bank-name"
                  class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="e.g. First National Bank / Chase"
                />
              </div>

              <div class="space-y-1.5">
                <label for="bank-account-name" class="block text-xs font-medium text-[var(--text-secondary)]">
                  {t.fields.accountName}
                </label>
                <input
                  type="text"
                  id="bank-account-name"
                  class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="Account beneficiary name"
                />
              </div>

              <div class="space-y-1.5">
                <label for="bank-account-number" class="block text-xs font-medium text-[var(--text-secondary)]">
                  {t.fields.accountNumber}
                </label>
                <input
                  type="text"
                  id="bank-account-number"
                  class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] font-mono placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="000123456789"
                />
              </div>

              <div class="space-y-1.5">
                <label for="bank-ifsc" class="block text-xs font-medium text-[var(--text-secondary)]">
                  {t.fields.ifsc}
                </label>
                <input
                  type="text"
                  id="bank-ifsc"
                  class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] font-mono placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="ROUTING123 / EXAMP01"
                />
              </div>

              <div class="space-y-1.5">
                <label for="bank-upi-id" class="block text-xs font-medium text-[var(--text-secondary)]">
                  {t.fields.upiId}
                </label>
                <input
                  type="text"
                  id="bank-upi-id"
                  class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] font-mono placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="business@upi"
                />
              </div>

              <div class="space-y-1.5">
                <label for="invoice-payment-terms" class="block text-xs font-medium text-[var(--text-secondary)]">
                  {t.fields.paymentTerms}
                </label>
                <input
                  type="text"
                  id="invoice-payment-terms"
                  class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="e.g. Net 30 / Due on Receipt"
                />
              </div>
            </div>
          </div>

          <button
            type="button"
            id="btn-toggle-banking"
            class="px-2.5 py-1 rounded-md border border-dashed border-[var(--border)] text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer"
          >
            {t.actions.addBankDetails}
          </button>
        </section>

        <!-- 8. Notes, Terms, Declaration & Signature -->
        <section class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border)]">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)] flex items-center gap-2">
              <PenTool class="w-3.5 h-3.5" />
              <span>{t.sections.legal}</span>
            </h2>
            <span class="text-[11px] text-[var(--text-muted)]">Step 8</span>
          </div>

          <!-- Notes Textarea -->
          <div id="notes-wrap" class="hidden space-y-1.5">
            <label for="invoice-notes" class="block text-xs font-medium text-[var(--text-secondary)]">
              {t.document.notesLabel}
            </label>
            <textarea
              id="invoice-notes"
              rows="2"
              class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)] resize-none"
              placeholder={t.fields.notesPlaceholder}
            ></textarea>
          </div>

          <!-- Terms & Conditions Optional Section -->
          <div id="terms-section-container" class="space-y-1.5">
            <!-- When Disabled -->
            <div id="terms-disabled-view">
              <button
                type="button"
                id="btn-toggle-terms"
                class="px-2.5 py-1 rounded-md border border-dashed border-[var(--border)] text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer inline-flex items-center gap-1.5 focus:outline-none focus:ring-1 focus:ring-[var(--border-focus)]"
              >
                <span>{t.actions.addTerms}</span>
              </button>
            </div>

            <!-- When Enabled -->
            <div id="terms-wrap" class="hidden space-y-1.5">
              <label for="invoice-terms" class="block text-xs font-medium text-[var(--text-secondary)] uppercase tracking-wider">
                {t.fields.terms}
              </label>
              <textarea
                id="invoice-terms"
                rows="2"
                class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)] resize-none"
                placeholder={t.fields.termsPlaceholder}
              ></textarea>
              <div class="flex justify-start">
                <button
                  type="button"
                  id="btn-remove-terms"
                  class="text-xs text-[var(--text-muted)] hover:text-[var(--negative-text)] transition-colors cursor-pointer inline-flex items-center gap-1 focus:outline-none focus:ring-1 focus:ring-[var(--border-focus)] rounded py-0.5"
                >
                  <span aria-hidden="true">✕</span>
                  <span>{t.actions.removeTerms}</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Declaration -->
          <div id="declaration-wrap" class="hidden space-y-1.5">
            <label for="invoice-declaration" class="block text-xs font-medium text-[var(--text-secondary)]">
              {t.fields.declaration}
            </label>
            <textarea
              id="invoice-declaration"
              rows="2"
              class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)] resize-none"
              placeholder="We declare that this document shows the actual price and that all particulars are true and correct."
            ></textarea>
          </div>

          <!-- Jurisdiction -->
          <div id="jurisdiction-wrap" class="hidden space-y-1.5">
            <label for="invoice-jurisdiction" class="block text-xs font-medium text-[var(--text-secondary)]">
              {t.fields.jurisdiction}
            </label>
            <input
              type="text"
              id="invoice-jurisdiction"
              class="w-full rounded-lg border border-[var(--border)] bg-[var(--input-background)] px-3 py-2 text-xs sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
              placeholder="Subject to Local Jurisdiction"
            />
          </div>

          <!-- Authorized Signatory -->
          <div id="signatory-wrap" class="hidden p-3.5 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div class="space-y-1">
                <label for="sig-name" class="block text-[11px] text-[var(--text-secondary)]">
                  {t.fields.signatoryName}
                </label>
                <input
                  type="text"
                  id="sig-name"
                  class="w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="Authorised Signatory"
                />
              </div>
              <div class="space-y-1">
                <label for="sig-title" class="block text-[11px] text-[var(--text-secondary)]">
                  {t.fields.signatoryTitle}
                </label>
                <input
                  type="text"
                  id="sig-title"
                  class="w-full rounded-md border border-[var(--border)] bg-[var(--input-background)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)]"
                  placeholder="Director / Partner / Owner"
                />
              </div>
            </div>
          </div>

          <!-- Legal Action Pills -->
          <div class="pt-2 flex flex-wrap gap-2 text-xs">
            <button type="button" id="btn-toggle-notes" class="px-2.5 py-1 rounded-md border border-dashed border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer">
              {t.actions.addNotes}
            </button>
            <button type="button" id="btn-toggle-declaration" class="px-2.5 py-1 rounded-md border border-dashed border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer">
              {t.actions.addDeclaration}
            </button>
            <button type="button" id="btn-toggle-jurisdiction" class="px-2.5 py-1 rounded-md border border-dashed border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer">
              {t.actions.addJurisdiction}
            </button>
            <button type="button" id="btn-toggle-signatory" class="px-2.5 py-1 rounded-md border border-dashed border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--border-focus)] transition-colors cursor-pointer">
              {t.actions.addSignature}
            </button>
          </div>
        </section>

        <!-- Privacy Notice -->
        <div class="p-3.5 rounded-lg border border-[var(--border)] bg-[var(--surface-subtle)] text-[11px] text-[var(--text-muted)] leading-relaxed">
          <span>{t.privacyNotice}</span>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Professional Paper Live Preview (Zero Visual Footprint) -->
    <div id="invoice-preview-col" class="hidden lg:block lg:col-span-6 lg:sticky lg:top-24">
      <!-- Printable Sheet Container -->
      <div
        id="invoice-paper-sheet"
        class="bg-white text-neutral-900 rounded-lg shadow-xl border border-neutral-300 p-8 sm:p-10 print:p-0 font-sans text-sm leading-relaxed max-w-full overflow-hidden relative"
      >
        <!-- Sample Watermark / Badge -->
        <div id="doc-sample-badge" class="hidden absolute top-4 right-4 text-[10px] uppercase tracking-wider font-mono font-bold text-neutral-500 border border-neutral-300 rounded px-2.5 py-0.5 bg-neutral-100/90 no-print select-none">
          EXAMPLE PREVIEW
        </div>

        <!-- Optional Copy Label Tag -->
        <div id="doc-copy-label" class="hidden text-right pb-2 text-[11px] uppercase font-mono tracking-widest text-neutral-500 font-semibold border-b border-neutral-200 mb-4">
        </div>

        <!-- Document Top: Supplier Details & Document Title/Meta -->
        <div id="doc-top-header" class="flex flex-col sm:flex-row justify-between gap-6 pb-4 border-b border-neutral-200">
          <!-- Left: Brand / Supplier Info -->
          <div class="space-y-1.5 max-w-[340px]">
            <div id="doc-logo-wrap" class="hidden pb-1">
              <img id="doc-logo-img" src="" alt="Business Logo" class="max-h-14 max-w-[180px] object-contain" />
            </div>
            <h3 id="doc-seller-name" class="text-lg sm:text-xl font-bold tracking-tight text-neutral-900 leading-tight">
            </h3>
            <p id="doc-seller-address" class="text-sm text-neutral-600 whitespace-pre-line leading-relaxed hidden">
            </p>
            <div id="doc-seller-contact" class="text-sm text-neutral-600 space-y-0.5 pt-0.5">
              <div id="doc-seller-email" class="hidden"></div>
              <div id="doc-seller-phone" class="hidden"></div>
              <div id="doc-seller-tax-id" class="font-mono text-xs sm:text-[13px] pt-0.5 hidden"></div>
              <div id="doc-seller-pan" class="font-mono text-xs sm:text-[13px] hidden"></div>
              <div id="doc-seller-state" class="text-xs sm:text-[13px] text-neutral-600 hidden"></div>
              <div id="doc-seller-website" class="text-xs sm:text-[13px] text-neutral-500 hidden"></div>
            </div>
          </div>

          <!-- Right: Document Type Heading & Meta Box -->
          <div class="sm:text-right space-y-1.5 min-w-[220px]">
            <h2 id="doc-title" class="text-2xl sm:text-3xl font-black tracking-tight text-neutral-900 uppercase">
              {t.document.invoiceTitle}
            </h2>
            <div class="space-y-1 text-xs sm:text-sm pt-1">
              <div id="doc-number-row" class="flex sm:justify-end gap-2">
                <span id="doc-number-label" class="text-neutral-500">{t.document.invoiceNumberLabel}:</span>
                <span id="doc-invoice-number" class="font-mono font-bold text-neutral-900"></span>
              </div>
              <div id="doc-date-row" class="flex sm:justify-end gap-2">
                <span class="text-neutral-500">{t.document.dateLabel}:</span>
                <span id="doc-invoice-date" class="font-medium text-neutral-900">{todayStr}</span>
              </div>
              <div id="doc-due-date-row" class="flex sm:justify-end gap-2">
                <span id="doc-due-date-label" class="text-neutral-500">{t.document.dueDateLabel}:</span>
                <span id="doc-invoice-due-date" class="font-medium text-neutral-900">{defaultDueDate}</span>
              </div>
              <div id="doc-place-supply-row" class="hidden flex sm:justify-end gap-2">
                <span class="text-neutral-500">{t.fields.placeOfSupply}:</span>
                <span id="doc-place-supply-val" class="font-medium text-neutral-900"></span>
              </div>
              <div id="doc-payment-terms-wrap" class="hidden flex sm:justify-end gap-2">
                <span class="text-neutral-500">{t.document.paymentTermsLabel}:</span>
                <span id="doc-payment-terms" class="font-medium text-neutral-900"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Bill To & Ship To Grid (Zero footprint: columns hide if empty) -->
        <div id="doc-entities-row" class="py-4 border-b border-neutral-200 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Bill To Card -->
          <div id="doc-bill-to-card" class="space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-widest text-neutral-400 block mb-1">
              {t.document.billToLabel}
            </span>
            <div id="doc-customer-company" class="text-base font-bold text-neutral-900"></div>
            <div id="doc-customer-name" class="text-sm text-neutral-700 font-medium hidden"></div>
            <div id="doc-customer-address" class="text-sm text-neutral-600 whitespace-pre-line leading-relaxed hidden"></div>
            <div id="doc-customer-contact" class="text-sm text-neutral-600 space-y-0.5 pt-0.5">
              <div id="doc-customer-email" class="hidden"></div>
              <div id="doc-customer-phone" class="hidden"></div>
              <div id="doc-customer-tax-id" class="font-mono text-xs sm:text-[13px] hidden"></div>
              <div id="doc-customer-pan" class="font-mono text-xs sm:text-[13px] hidden"></div>
              <div id="doc-customer-state" class="text-xs sm:text-[13px] text-neutral-600 hidden"></div>
            </div>
          </div>

          <!-- Ship To / Consignee Card (Only if enabled) -->
          <div id="doc-ship-to-card" class="hidden space-y-1 sm:border-l sm:border-neutral-200 sm:pl-6">
            <span class="text-[11px] font-bold uppercase tracking-widest text-neutral-400 block mb-1">
              {t.document.shipToLabel}
            </span>
            <div id="doc-ship-name" class="text-base font-bold text-neutral-900"></div>
            <div id="doc-ship-address" class="text-sm text-neutral-600 whitespace-pre-line leading-relaxed hidden"></div>
            <div id="doc-ship-destination" class="text-sm text-neutral-700 font-medium hidden"></div>
            <div id="doc-ship-tax-id" class="font-mono text-xs sm:text-[13px] text-neutral-600 hidden"></div>
          </div>
        </div>

        <!-- Optional References Strip -->
        <div id="doc-references-strip" class="hidden py-2.5 border-b border-neutral-200 text-xs sm:text-sm flex flex-wrap gap-x-6 gap-y-1.5 text-neutral-700">
          <div id="doc-ref-order" class="hidden">
            <span class="text-neutral-400">Order/PO:</span> <strong id="doc-ref-order-val" class="text-neutral-900 font-medium"></strong>
          </div>
          <div id="doc-ref-order-date" class="hidden">
            <span class="text-neutral-400">Order Date:</span> <span id="doc-ref-order-date-val" class="text-neutral-900"></span>
          </div>
          <div id="doc-ref-quote" class="hidden">
            <span class="text-neutral-400">Quote Ref:</span> <strong id="doc-ref-quote-val" class="text-neutral-900 font-medium"></strong>
          </div>
          <div id="doc-ref-quote-date" class="hidden">
            <span class="text-neutral-400">Quote Date:</span> <span id="doc-ref-quote-date-val" class="text-neutral-900"></span>
          </div>
        </div>

        <!-- Dynamic Items Table -->
        <div id="doc-items-table-wrap" class="py-4 overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[360px]" id="doc-items-table">
            <thead id="doc-items-thead">
              <tr class="border-b-2 border-neutral-300 text-xs uppercase font-bold text-neutral-600 tracking-wider">
                <th id="th-index" class="py-2 pr-2 w-8">#</th>
                <th id="th-desc" class="py-2 px-2.5 min-w-[36%]">{t.document.descHeader}</th>
                <th id="th-hsn" class="hidden py-2 px-2.5 text-right w-20">{t.document.hsnHeader}</th>
                <th id="th-unit" class="hidden py-2 px-2.5 text-right w-16">{t.document.unitHeader}</th>
                <th id="th-qty" class="py-2 px-2.5 text-right w-16">{t.document.qtyHeader}</th>
