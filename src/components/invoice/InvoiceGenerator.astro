    // Populate Form Fields
    function populateFormFields() {
      // Customizer UI
      layoutPickerBtns.forEach((btn) => {
        const l = btn.getAttribute('data-layout');
        const isActive = l === (state.layout || 'classic');
        btn.classList.toggle('bg-[var(--text-primary)]', isActive);
        btn.classList.toggle('text-[var(--background)]', isActive);
        btn.classList.toggle('font-semibold', isActive);
        btn.classList.toggle('shadow-xs', isActive);
        btn.classList.toggle('bg-[var(--surface-elevated)]', !isActive);
        btn.classList.toggle('text-[var(--text-secondary)]', !isActive);
      });

      densityPickerBtns.forEach((btn) => {
        const d = btn.getAttribute('data-density');
        const isActive = d === (state.density || 'comfortable');
        btn.classList.toggle('bg-[var(--text-primary)]', isActive);
        btn.classList.toggle('text-[var(--background)]', isActive);
        btn.classList.toggle('font-semibold', isActive);
        btn.classList.toggle('shadow-xs', isActive);
        btn.classList.toggle('bg-[var(--surface-elevated)]', !isActive);
        btn.classList.toggle('text-[var(--text-secondary)]', !isActive);
      });

      if (colToggleIndex) colToggleIndex.checked = state.tableColumns.index !== false;
      if (colToggleHsn) colToggleHsn.checked = !!state.tableColumns.hsn;
      if (colToggleUnit) colToggleUnit.checked = !!state.tableColumns.unit;
      if (colToggleQty) colToggleQty.checked = state.tableColumns.qty !== false;
      if (colToggleRate) colToggleRate.checked = state.tableColumns.rate !== false;
      if (colToggleDiscount) colToggleDiscount.checked = !!state.tableColumns.discount;
      if (colToggleTax) colToggleTax.checked = !!state.tableColumns.tax;

      if (secToggleShipping) secToggleShipping.checked = !!state.shippingEnabled;
      if (secToggleReferences) secToggleReferences.checked = !!(state.refOrderNumber || state.refOrderDate || state.refQuoteNumber || state.refQuoteDate || state.sectionsConfig?.references);
      if (secTogglePayment) secTogglePayment.checked = Boolean(state.bankDetailsEnabled && state.sectionsConfig?.payment !== false);
      if (secToggleNotes) secToggleNotes.checked = Boolean(state.sectionsConfig?.notes !== false && (state.notes?.trim() || state.sectionsConfig?.notes));
      if (secToggleTerms) secToggleTerms.checked = Boolean(state.sectionsConfig?.terms);
      if (secToggleDeclaration) secToggleDeclaration.checked = Boolean(state.sectionsConfig?.declaration !== false && (state.declaration?.trim() || state.sectionsConfig?.declaration));
      if (secToggleSignature) secToggleSignature.checked = Boolean(state.signatoryEnabled && state.sectionsConfig?.signature !== false);

