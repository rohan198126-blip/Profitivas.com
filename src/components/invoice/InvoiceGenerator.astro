<!-- Client-Side Reactive Document Studio Engine -->
<script>
  import { SUPPORTED_CURRENCIES } from '../../lib/i18n/invoice';
  import type {
    DocumentType,
    DocumentLayout,
    DocumentDensity,
    CommercialDocumentState,
    TaxMode,
    GstSupplyType,
  } from '../../lib/i18n/invoice/types';
  import { formatAmountInWords } from '../../lib/utils/numberToWords';

  const STORAGE_KEY = 'profitivas_business_document_v2';
  const LEGACY_STORAGE_KEY = 'profitivas_invoice_draft_v1';
  const todayDateStr = new Date().toISOString().split('T')[0];

  function initBusinessDocumentGenerator() {
    const root = document.getElementById('invoice-generator-root');
    if (!root) return;

    const currentLocale = root.getAttribute('data-locale') || 'en';

    // Blank State by default (No hardcoded demo data)
    function createBlankState(): CommercialDocumentState {
      const today = todayDateStr;
      const due = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

      return {
        version: 2,
        documentType: 'invoice',
        layout: 'classic',
        density: 'comfortable',
        tableColumns: {
          index: true,
          item: true,
          hsn: false,
          unit: false,
          qty: true,
          rate: true,
          discount: false,
          tax: false,
          amount: true,
        },
        sectionsConfig: {
          shipping: false,
          references: false,
          payment: false,
          notes: false,
          terms: false,
          declaration: false,
          signature: false,
        },
        customTitle: '',
        documentNumber: 'DOC-001',
        documentDate: today,
        dueDate: due,
        validUntil: due,
        currency: currentLocale === 'ja' ? 'JPY' : currentLocale === 'ko' ? 'KRW' : currentLocale === 'pt' ? 'BRL' : 'USD',
        copyLabel: '',
        placeOfSupply: '',
        placeOfSupplyCode: '',

        // Supplier
        sellerName: '',
        sellerLogo: '',
        sellerAddress: '',
        sellerEmail: '',
        sellerPhone: '',
        sellerTaxId: '',
        sellerPan: '',
        sellerState: '',
        sellerStateCode: '',
        sellerWebsite: '',

        // Customer
        customerCompany: '',
        customerName: '',
        customerAddress: '',
        customerEmail: '',
        customerPhone: '',
        customerTaxId: '',
        customerPan: '',
        customerState: '',
        customerStateCode: '',

        // Shipping
        shippingEnabled: false,
        shippingSameAsCustomer: true,
        shippingName: '',
        shippingAddress: '',
        shippingTaxId: '',
        shippingDestination: '',

        // References
        refOrderNumber: '',
        refOrderDate: '',
        refPoNumber: '',
        refPoDate: '',
        refQuoteNumber: '',
        refQuoteDate: '',
        refDeliveryNote: '',

        // Tax
        taxMode: 'none',
        gstSupplyType: 'cgst_sgst',
        reverseCharge: false,
        enableRoundOff: true,

        // Banking
        bankDetailsEnabled: false,
        bankName: '',
        bankAccountName: '',
        bankAccountNumber: '',
        bankIfsc: '',
        bankBranch: '',
        bankUpiId: '',
        paymentMethod: '',
        paymentTerms: '',

        // Legal
        notes: '',
        termsAndConditions: '',
        declaration: '',
        jurisdiction: '',
        signatoryEnabled: false,
        signatoryName: '',
        signatoryDesignation: '',
        signatoryImage: '',

        items: [
          {
            id: 'item-1',
            description: '',
            hsnSac: '',
            quantity: 1,
            unit: '',
            unitPrice: 0,
            discountPercent: 0,
            taxPercent: 0,
          },
        ],
      };
    }

    let isSampleActive = false;
    let state: CommercialDocumentState = createBlankState();

    // Restore from localStorage or legacy key
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed && Array.isArray(parsed.items) && parsed.items.length > 0) {
          const blank = createBlankState();
          state = {
            ...blank,
            ...parsed,
            tableColumns: { ...blank.tableColumns, ...(parsed.tableColumns || {}) },
            sectionsConfig: { ...blank.sectionsConfig, ...(parsed.sectionsConfig || {}) },
          };

          // Fictional sample strings from btnLoadSample
          const sampleTerms = '1. Payment is due within 30 days of invoice date.\n2. Overdue balances are subject to a 1.5% monthly finance charge.\n3. All project deliverables remain intellectual property until full settlement.';
          const sampleDeclaration = 'We declare that this invoice shows the actual price of the services described and that all particulars are true and correct.';
          const sampleNotes = 'Thank you for your business. Please reach out to hello@northstar-example.com for any billing inquiries.';

          const isFictionalSampleSupplier = state.sellerName === 'Northstar Creative Studio';

          if (isFictionalSampleSupplier) {
            isSampleActive = true;
          } else {
            // If the user entered their own business details, eliminate any unrequested leftover sample clauses
            if (state.termsAndConditions?.trim() === sampleTerms.trim()) {
              state.termsAndConditions = '';
              state.sectionsConfig.terms = false;
            }
            if (state.declaration?.trim() === sampleDeclaration.trim()) {
              state.declaration = '';
              state.sectionsConfig.declaration = false;
            }
            if (state.notes?.trim() === sampleNotes.trim()) {
              state.notes = '';
              state.sectionsConfig.notes = false;
            }
            if (state.bankName === 'First Example Bank') {
              state.bankDetailsEnabled = false;
              state.bankName = '';
              state.bankAccountName = '';
              state.bankAccountNumber = '';
              state.bankIfsc = '';
              state.bankBranch = '';
              state.sectionsConfig.payment = false;
            }
            if (state.signatoryName === 'Alex Morgan') {
              state.signatoryEnabled = false;
              state.signatoryName = '';
              state.signatoryDesignation = '';
              state.sectionsConfig.signature = false;
            }
          }
        }
      } else {
        const legacy = localStorage.getItem(LEGACY_STORAGE_KEY);
        if (legacy) {
          const parsedLegacy = JSON.parse(legacy);
          if (parsedLegacy && Array.isArray(parsedLegacy.items)) {
            state = {
              ...createBlankState(),
              sellerName: parsedLegacy.sellerName || '',
              sellerAddress: parsedLegacy.sellerAddress || '',
              sellerEmail: parsedLegacy.sellerEmail || '',
              customerCompany: parsedLegacy.customerCompany || '',
              customerName: parsedLegacy.customerName || '',
              items: parsedLegacy.items,
            };
          }
        }
      }
    } catch {
      // Safe fallback
    }

    function saveToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {}
    }

    function getCurrencyConfig(code: string) {
      return SUPPORTED_CURRENCIES.find((c) => c.code === code) || SUPPORTED_CURRENCIES[0];
    }

    function formatMoney(amount: number, currencyCode: string): string {
      if (!Number.isFinite(amount)) return '$0.00';
      const cfg = getCurrencyConfig(currencyCode);
      const decimals = cfg.decimals;

      const localeMap: Record<string, string> = {
        en: 'en-US',
        es: 'es-ES',
        fr: 'fr-FR',
        de: 'de-DE',
        pt: 'pt-BR',
        it: 'it-IT',
        ja: 'ja-JP',
        ko: 'ko-KR',
      };
      const activeIntlLocale = localeMap[currentLocale] || 'en-US';

      try {
        return new Intl.NumberFormat(activeIntlLocale, {
          style: 'currency',
          currency: currencyCode,
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        }).format(amount);
      } catch {
        return `${cfg.symbol}${amount.toFixed(decimals)}`;
      }
    }

    // Top Controls
    const docTypeSelect = document.getElementById('doc-type-select') as HTMLSelectElement | null;
    const docCustomTitleWrap = document.getElementById('doc-custom-title-wrap');
    const docCustomTitleInput = document.getElementById('doc-custom-title-input') as HTMLInputElement | null;
    const currencySelect = document.getElementById('invoice-currency') as HTMLSelectElement | null;
    const copyLabelSelect = document.getElementById('doc-copy-label-select') as HTMLSelectElement | null;

    // Seller Controls
    const sellerNameInput = document.getElementById('seller-name') as HTMLInputElement | null;
    const sellerAddressInput = document.getElementById('seller-address') as HTMLTextAreaElement | null;
    const sellerEmailInput = document.getElementById('seller-email') as HTMLInputElement | null;
    const sellerPhoneInput = document.getElementById('seller-phone') as HTMLInputElement | null;
    const sellerTaxIdInput = document.getElementById('seller-tax-id') as HTMLInputElement | null;
    const sellerPanInput = document.getElementById('seller-pan') as HTMLInputElement | null;
    const sellerStateInput = document.getElementById('seller-state') as HTMLInputElement | null;
    const sellerStateCodeInput = document.getElementById('seller-state-code') as HTMLInputElement | null;
    const sellerWebsiteInput = document.getElementById('seller-website') as HTMLInputElement | null;
    const logoFileInput = document.getElementById('logo-file-input') as HTMLInputElement | null;
    const logoPreviewThumbWrap = document.getElementById('logo-preview-thumb-wrap');
    const logoPreviewThumb = document.getElementById('logo-preview-thumb') as HTMLImageElement | null;
    const btnRemoveLogo = document.getElementById('btn-remove-logo');

    // Customer Controls
    const customerCompanyInput = document.getElementById('customer-company') as HTMLInputElement | null;
    const customerNameInput = document.getElementById('customer-name') as HTMLInputElement | null;
    const customerAddressInput = document.getElementById('customer-address') as HTMLTextAreaElement | null;
