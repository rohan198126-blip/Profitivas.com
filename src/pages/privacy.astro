---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';

const pageTitle = 'Privacy Policy — Profitivas';
const pageDescription = 'Profitivas Privacy Policy: our calculators execute locally in your browser. Learn how we handle privacy, local storage, and website data.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://profitivas.com/privacy"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ label: 'Privacy Policy' }]} />

    <header class="mt-6 mb-10 sm:mb-12">
      <p class="text-xs font-medium text-[var(--text-muted)] tracking-[0.2em] uppercase mb-2.5">
        Legal & Transparency
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] tracking-tight">
        Privacy Policy
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] mt-3 leading-relaxed font-normal">
        Last updated: September 2026. How Profitivas protects your privacy and commercial calculations.
      </p>
    </header>

    <article class="space-y-10 sm:space-y-12 text-sm text-[var(--text-secondary)] leading-relaxed">
      <!-- Section 1: Current Architecture & Processing -->
      <section class="space-y-3 pt-6 border-t border-[var(--border)]">
        <h2 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] tracking-tight">
          1. Current Architecture: Local Client-Side Execution
        </h2>
        <p>
          Profitivas calculators are built with client-side JavaScript that executes strictly inside your web browser. When you enter unit costs, retail prices, sales volumes, or target margins, that data never leaves your device.
        </p>
        <p>
          We do not record, transmit, analyze, or sell any commercial or financial figures you input into our calculation tools. You can calculate private business scenarios with confidence that your inputs are not sent to any remote database.
        </p>
      </section>

      <!-- Section 2: Cookies & Local Storage -->
      <section class="space-y-3 pt-6 border-t border-[var(--border)]">
        <h2 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] tracking-tight">
          2. Local Storage & Current Cookie Practices
        </h2>
        <p>
          Profitivas does not currently deploy marketing profiling cookies, tracking pixels, or cross-site behavioral identifiers.
        </p>
        <p>
          We use browser <code class="font-mono text-xs text-[var(--text-primary)] bg-[var(--surface-elevated)] px-1.5 py-0.5 rounded border border-[var(--border)]">localStorage</code> solely to remember your visual theme preference (<code class="font-mono text-xs text-[var(--text-primary)]">profitivas-theme</code> set to "light" or "dark") so that you experience consistent styling across visits. No personal data is collected or linked to this setting.
        </p>
      </section>

      <!-- Section 3: Server Logs -->
      <section class="space-y-3 pt-6 border-t border-[var(--border)]">
        <h2 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] tracking-tight">
          3. Standard Infrastructure Logs
        </h2>
        <p>
          Like virtually all web properties, our hosting infrastructure automatically records basic technical access logs when requests are served. These logs may include your IP address, browser user-agent, referring URL, and request timestamps. These logs are used strictly for network security, DDoS mitigation, and system uptime maintenance.
        </p>
      </section>

      <!-- Section 4: Future Advertising & Monetization Disclosures (AdSense Readiness) -->
      <section class="space-y-3 pt-6 border-t border-[var(--border)]">
        <h2 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] tracking-tight">
          4. Future Advertising & Monetization Disclosures
        </h2>
        <p>
          Advertisements are not currently displayed on Profitivas. In the future, to keep these calculation instruments free and accessible to all entrepreneurs, we may introduce third-party advertising partners, including Google AdSense.
        </p>
        <p>
          When advertising is activated:
        </p>
        <ul class="list-disc list-inside space-y-1.5 pl-2 text-xs sm:text-sm">
          <li>Third-party vendors, including Google, will use cookies to serve ads based on prior visits to our website or other websites across the Internet.</li>
          <li>Google's use of advertising cookies enables it and its partners to serve ads based on your visit to Profitivas and/or other sites on the Internet.</li>
          <li>Users in jurisdictions requiring consent (such as the EEA, UK, and Switzerland) will be presented with a Google-certified Consent Management Platform (CMP) to accept, decline, or configure advertising cookie preferences.</li>
          <li>You may opt out of personalized advertising at any time by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] underline underline-offset-4 hover:opacity-80">Google Ads Settings</a> or through <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] underline underline-offset-4 hover:opacity-80">www.aboutads.info</a>.</li>
        </ul>
      </section>

      <!-- Section 5: User Rights & Browser Controls -->
      <section class="space-y-3 pt-6 border-t border-[var(--border)]">
        <h2 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] tracking-tight">
          5. User Rights & Privacy Controls
        </h2>
        <p>
          Depending on your jurisdiction (such as under the EU General Data Protection Regulation / UK GDPR or the California Consumer Privacy Act / CPRA), you have rights regarding your digital privacy:
        </p>
        <ul class="list-disc list-inside space-y-1.5 pl-2 text-xs sm:text-sm">
          <li><strong>Right to Know & Access:</strong> Because our calculation tools execute client-side and do not collect user accounts or identifying profiles, we do not maintain personal databases.</li>
          <li><strong>Browser Cookie Controls:</strong> You can configure your browser to block, clear, or alert you about cookies. Disabling cookies will not affect your ability to use any Profitivas calculator.</li>
          <li><strong>Global Privacy Control (GPC):</strong> We respect browser-level privacy signals and opt-out preferences.</li>
        </ul>
      </section>

      <!-- Section 6: Contact & Updates -->
      <section class="space-y-3 pt-6 border-t border-[var(--border)]">
        <h2 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] tracking-tight">
          6. Updates & Contact
        </h2>
        <p>
          We may update this policy periodically to reflect platform enhancements or regulatory requirements. Any future implementation of advertising or analytics will be accompanied by updated disclosures and appropriate consent mechanisms.
        </p>
        <p>
          If you have questions regarding this policy, please review our <a href="/about" class="text-[var(--text-primary)] underline underline-offset-4 hover:opacity-80">About page</a> or reach out through our contact information.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>
