---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import InvoiceGenerator from '../components/invoice/InvoiceGenerator.astro';
import { getInvoiceTranslations } from '../lib/i18n/invoice';
import { ShieldCheck, ChevronDown, ArrowRight, Calculator } from 'lucide-astro';

const locale = 'en';
const t = getInvoiceTranslations(locale);
const canonicalUrl = 'https://profitivas.com/invoice-generator';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t.meta.title,
  url: canonicalUrl,
  description: t.meta.description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  creator: {
    '@type': 'Organization',
    name: 'Profitivas',
    url: 'https://profitivas.com',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const relatedCalculators = [
  {
    name: 'Profit Margin Calculator',
    slug: '/profit-margin-calculator',
    desc: 'Calculate gross profit margin and markup to ensure invoices maintain target profitability.',
  },
  {
    name: 'Markup Calculator',
    slug: '/markup-calculator',
    desc: 'Determine client billing markup percentages over wholesale costs and service expenses.',
  },
  {
    name: 'Selling Price Calculator',
    slug: '/selling-price-calculator',
    desc: 'Price products and services accurately based on cost of goods and target margins.',
  },
  {
    name: 'Gross Profit Calculator',
    slug: '/gross-profit-calculator',
    desc: 'Analyze top-line invoice revenue minus direct delivery costs across client engagements.',
  },
  {
    name: 'Revenue Calculator',
    slug: '/revenue-calculator',
    desc: 'Forecast monthly and annual billing volume across varied client retainers and project rates.',
  },
  {
    name: 'Commission Calculator',
    slug: '/commission-calculator',
    desc: 'Calculate sales team payouts, finder fees, and tiered bonuses from invoiced totals.',
  },
];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <JsonLd schema={webAppSchema} />
  <JsonLd schema={faqSchema} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <div class="no-print">
      <Breadcrumbs
        locale={locale}
        items={[
          { label: 'Business Tools', href: '/calculators' },
          { label: t.header.h1 },
        ]}
      />
    </div>

    <!-- Page Header Header -->
    <header class="max-w-3xl mx-auto text-center mt-6 mb-10 sm:mb-12 no-print">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-[var(--surface-elevated)] border border-[var(--border)] text-[var(--text-muted)] mb-3">
        <ShieldCheck class="w-3.5 h-3.5 text-[var(--positive-text)]" />
        <span>{t.header.eyebrow} &bull; Private &amp; Client-Side</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[var(--text-primary)] tracking-tight">
        {t.header.h1}
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] mt-3 font-normal leading-relaxed">
        {t.header.subtitle}
      </p>
    </header>

    <!-- Interactive Invoice Tool -->
    <main>
      <InvoiceGenerator locale={locale} />
    </main>

    <!-- Content & Educational Guide Section -->
    <section class="max-w-4xl mx-auto mt-20 sm:mt-24 space-y-16 no-print">
      <!-- FAQ Accordion -->
      <div class="space-y-6">
        <div class="text-center space-y-2">
          <h2 class="text-xl sm:text-2xl font-bold text-[var(--text-primary)] tracking-tight">
            Frequently Asked Questions
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)]">
            Everything you need to know about creating, saving, and printing invoices on Profitivas.
          </p>
        </div>

        <div class="space-y-3">
          {t.faqs.map((faq) => (
            <details class="group border border-[var(--border)] rounded-xl bg-[var(--surface)] p-4 sm:p-5 transition-colors open:bg-[var(--surface-elevated)]">
              <summary class="flex items-center justify-between font-medium text-sm sm:text-base text-[var(--text-primary)] cursor-pointer list-none select-none">
                <span>{faq.question}</span>
                <ChevronDown class="w-4 h-4 text-[var(--text-muted)] group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4" />
              </summary>
              <div class="mt-3 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed border-t border-[var(--border)] pt-3">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- Related Business Calculators -->
      <div class="border-t border-[var(--border)] pt-12 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)] tracking-tight">
              {t.relatedCalculators.heading}
            </h2>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
              {t.relatedCalculators.subtitle}
            </p>
          </div>
          <a
            href="/calculators"
            class="inline-flex items-center gap-1 text-xs font-medium text-[var(--text-primary)] hover:underline self-start sm:self-auto shrink-0"
          >
            <span>View all 15 calculators</span>
            <ArrowRight class="w-3 h-3" />
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedCalculators.map((calc) => (
            <a
              href={calc.slug}
              class="group p-4 rounded-xl border border-[var(--border)] bg-[var(--surface)] hover:bg-[var(--surface-subtle)] hover:border-[var(--border-focus)] transition-all flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <Calculator class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-colors" />
                  <h3 class="text-sm font-semibold text-[var(--text-primary)]">
                    {calc.name}
                  </h3>
                </div>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                  {calc.desc}
                </p>
              </div>
              <div class="mt-4 flex items-center gap-1 text-xs font-medium text-[var(--text-muted)] group-hover:text-[var(--text-primary)]">
                <span>Calculate now</span>
                <ArrowRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
